{
  "status": "DRAFT - awaiting Shibi approval",
  "version": 1,
  "_note": "DRAFT proposal (task T1); every name, rule and number here is a proposal, not a design value. Mirrors docs/design/traits.md. Do NOT wire into gameplay, UI or the economy until Shibi approves (OQ-42).",
  "counted_matches": {
    "_todo": "OQ-44",
    "modes": ["koth"],
    "exclude": ["tutorial", "campaign"],
    "note": "Only multiplayer matches count. Add a mode id here when Slayer, Capture the Eagle or Oddball ship."
  },
  "good_traits_permanent": true,
  "_good_traits_permanent_todo": "OQ-43",
  "rule_types": {
    "lifetime_sum": "Sum of `stat` over all counted matches >= `min`.",
    "lifetime_count": "Number of counted matches (inside `scope`) where every `where` condition holds >= `count`.",
    "consecutive": "The last `count` counted matches (inside `scope`) all meet every `where` condition.",
    "window_count": "Among the last `window` counted matches (inside `scope`), at least `count` meet every `where` condition."
  },
  "condition_ops": ["==", "!=", ">=", "<=", ">", "<"],
  "match_stats": {
    "mode": {"type": "string", "description": "Mode id of the match (e.g. koth)."},
    "finished": {"type": "bool", "description": "1 if you were still in the match when it ended."},
    "quit": {"type": "bool", "description": "1 if you chose to leave before the match ended.", "_todo": "OQ-44 (does a lost connection count?)"},
    "won": {"type": "bool", "description": "1 if your squad won. A draw counts as 0."},
    "was_host": {"type": "bool", "description": "1 if your phone hosted the match."},
    "host_abandoned": {"type": "bool", "description": "1 if you were host and the match closed because you left or did not return within the host-drop reconnect pause."},
    "kills": {"type": "int", "description": "Enemies (human or bot) you killed yourself. Squad-bot kills are not included.", "_todo": "OQ-46"},
    "deaths": {"type": "int", "description": "Times you died, suicides included."},
    "suicides": {"type": "int", "description": "Deaths with no enemy credited (own grenade, fall, own mine...)."},
    "headshot_kills": {"type": "int", "description": "Kills where the killing hit was a headshot."},
    "assassinations": {"type": "int", "description": "Melee kills from behind (DESIGN.md instant kill)."},
    "hill_seconds": {"type": "int", "description": "Seconds you spent inside the hill."},
    "hill_defense_kills": {"type": "int", "description": "Kills that met the custos_collis medal trigger (data/medals.json)."},
    "saves": {"type": "int", "description": "Kills that met the corona_civica medal trigger (data/medals.json)."},
    "squad_bot_kills": {"type": "int", "description": "Kills made by your squad bots (the ones that pay you Denarii)."},
    "medals": {"type": "int", "description": "Medals you earned in the match."},
    "afk_timeouts": {"type": "int", "description": "Times the killcam timed out and you were respawned at a random spot (DESIGN.md anti-AFK)."},
    "spawn_kills": {"type": "int", "description": "Kills on enemies whose spawn protection had ended less than `window_after_protection_s` seconds earlier.", "window_after_protection_s": 3},
    "kill_death_ratio": {"type": "float", "derived": true, "description": "kills / max(deaths, 1)."},
    "headshot_ratio": {"type": "float", "derived": true, "description": "headshot_kills / max(kills, 1)."}
  },
  "traits": [
    {
      "id": "virtus", "kind": "good", "display_name": "Virtus", "latin_name": "Virtus", "english_meaning": "Valor",
      "earn": {"rule": "lifetime_sum", "stat": "kills", "min": 250},
      "show_in_lobby": true, "show_in_game_banner": false, "effects": []
    },
    {
      "id": "pietas", "kind": "good", "display_name": "Pietas", "latin_name": "Pietas", "english_meaning": "Dutiful devotion",
      "earn": {"rule": "lifetime_count", "where": [{"stat": "finished", "op": "==", "value": 1}], "count": 50},
      "show_in_lobby": true, "show_in_game_banner": false, "effects": []
    },
    {
      "id": "fides", "kind": "good", "display_name": "Fides", "latin_name": "Fides", "english_meaning": "Good faith, loyalty",
