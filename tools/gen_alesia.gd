extends SceneTree
## M2L1: writes the 1 km Alesia grey-box (data/maps/alesia_1km.json) from the numbers in its "generator" block, the
## gen_test_map.gd pattern: one seeded RandomNumberGenerator and a fixed order of work, so the same block gives the
## same files. Every size, count and name is a proposal (OQ-ALESIA-LAYOUT, a guess for Shibi). Writes:
## - data/maps/alesia_1km_cover.json (pieces, ring_pieces, decor) and alesia_1km_structures.json (pieces);
## - data/maps/alesia_1km_landmarks.json (the alesia_landmarks.json format);
## - the heights (binary HeightMapShape3D .res, 2 m, MapTerrain.save_heights) and the baked ground paint (a
##   compressed Image .res with its inputs hash, GroundPaint.save_baked);
## - the map json's derived keys: spawns, reserved_spots, generator.heights_sha256, generator.paint_sha256 (the
##   rest of the map json is kept; keys come out sorted).
## godot --headless --path . --script res://tools/gen_alesia.gd [-- --map=<id>] [--no-paint]
## --no-paint keeps the committed paint (painting 1024 px in GDScript takes seconds); the map json then keeps
## its old paint_sha256.
## M2 L2a: --map=<id> picks res://data/maps/<id>.json (default alesia_1km; e.g. --map=alesia_500). The output paths
## come from that map json as before. The 500 m map's extra passes (Arx wall ring, town grid, farmsteads, field wall
## runs, the outside strip, door/ladder id filters) run only when its generator block has their keys, so the 1 km
## map's output stays byte-identical (tests/test_alesia_1km_data.gd and tests/test_alesia_500_data.gd pin it).

const MAP_PATH := "res://data/maps/alesia_1km.json"
const COVER_TYPES := "res://data/maps/alesia_cover.json"
const NOTE := "M2L1 grey-box pieces of the 1 km Alesia, generated by tools/gen_alesia.gd from data/maps/alesia_1km.json \"generator\"; do not edit by hand (OQ-ALESIA-LAYOUT: every placement is a proposal)."
const WALL_TYPES := ["wall_walk", "wall_stair", "gate", "watchtower"]
const SPAN_M := 10.0
const RAMP_OFFSET_M := 9.7  # span half length 5 + ramp half length 4.7 (alesia's AqueductRamp sits 9.7 m from its span)
const _GenTest := preload("res://tools/gen_test_map.gd")


func _initialize() -> void:
	var started := Time.get_ticks_msec()
	var no_paint := OS.get_cmdline_user_args().has("--no-paint")
	var map_path := MAP_PATH
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--map="):
			map_path = map_path_of(arg.substr(6))
	var map_def := DataRegistry.parse_quiet(map_path)
	if map_def.is_empty() or not map_def.has("generator"):
		printerr("GEN_ALESIA problem: %s is missing or has no generator block" % map_path)
		quit(1)
		return
	var gen: Dictionary = map_def["generator"]
	var out := generate(map_def)
	var gen_ms := Time.get_ticks_msec() - started
	_write(String(map_def["cover_data"]), out["cover"])
	_write(String(map_def["structure_data"]), out["structures"])
	_write(String(map_def["landmarks"]), out["landmarks"])
	var terrain: MapTerrain = out["terrain"]
	var heights_err := MapTerrain.save_heights(terrain, String(gen["heights_path"]))
	map_def["spawns"] = out["spawns"]
	map_def["reserved_spots"] = out["reserved_spots"]
	map_def["generator"]["heights_sha256"] = sha256(terrain.heights.to_byte_array())
	var paint_ms := 0
	var paint_err := OK
	if not no_paint:
		var paint_from := Time.get_ticks_msec()
		var paint := paint_of(map_def, out)
		var settings := GroundPaint.settings_for(map_def)
		paint_err = GroundPaint.save_baked(paint["image"], String(settings["baked"]), paint["hash"])
		map_def["generator"]["paint_sha256"] = sha256((paint["image"] as Image).get_data())
		paint_ms = Time.get_ticks_msec() - paint_from
	_write(map_path, map_def)
	var problems: PackedStringArray = out["problems"]
	if heights_err != OK or paint_err != OK:
		problems.append("save failed: heights %d, paint %d" % [heights_err, paint_err])
	var counts := counts_of(out)
	print("GEN_ALESIA seed=%d cover=%d ring=%d decor=%d structures=%d walls_inner=%d walls_outer=%d max_joint_gap_m=%.3f ground_rejects=%d gen_ms=%d paint_ms=%d" % [
		int(gen["seed"]), counts["cover"], counts["ring"], counts["decor"], counts["structures"], counts["walls_inner"], counts["walls_outer"],
		float(out["max_joint_gap_m"]), int(out["ground_rejects"]), gen_ms, paint_ms])
	var extra: Dictionary = out["extra"]["counts"]
	var bk: Dictionary = out["breakables"]
	var ch: Dictionary = out["chests"]
	print("GEN_ALESIA extra: camps=%d inner=%d outer=%d arx=%d fields=%d breakables=%d (camps=%d inner_gates=%d outer_gates=%d arx=%d fields=%d) cover_wall=%d chests=%d (camps=%d arx=%d fields=%d)" % [
		int(extra["camps"]), int(extra["inner"]), int(extra["outer"]), int(extra["arx"]), int(extra["fields"]),
		int(bk["camps"]) + int(bk["inner_gates"]) + int(bk["outer_gates"]) + int(bk["arx"]) + int(bk["fields"]),
		int(bk["camps"]), int(bk["inner_gates"]), int(bk["outer_gates"]), int(bk["arx"]), int(bk["fields"]), int(out["cover_walls"]),
		int(ch["camps"]) + int(ch["arx"]) + int(ch["fields"]), int(ch["camps"]), int(ch["arx"]), int(ch["fields"])])
	var dc: Dictionary = out["doors"]
	print("GEN_ALESIA doors: doors=%d gates=%d open=%d closed=%d" % [int(dc["door"]), int(dc["gate"]), int(dc["open"]), int(dc["closed"])])
	var lc: Dictionary = out["ladders"]
	print("GEN_ALESIA ladders: ladders=%d blocks=%d first_end=%d other_end=%d none=%d" % [int(lc["ladders"]), int(lc["blocks"]), int(lc["first_end"]), int(lc["other_end"]), int(lc["none"])])
	for line: String in report_500(out):
		print(line)
	for line: String in out["shortfalls"]:
		print("GEN_ALESIA short: ", line)
	for p in problems:
		printerr("GEN_ALESIA problem: ", p)
	quit(1 if not problems.is_empty() else 0)


## M2 L2a: appends `line` to the state's PackedStringArray `key` ("problems" or "shortfalls") in place. Measured on
## Godot 4.7.2: `(state[key] as PackedStringArray).append(line)` appends to a COPY (the line was lost), while a typed
## variable shares the array; so every problem and shortfall goes through here.
static func _note(state: Dictionary, key: String, line: String) -> void:
	var list: PackedStringArray = state[key]
	list.append(line)


## M2 L2a: the map json path of a --map value: a bare id (alesia_500) or a whole res:// path.
static func map_path_of(value: String) -> String:
	return value if value.begins_with("res://") else "res://data/maps/%s.json" % value


static func _write(path: String, data: Dictionary) -> void:
	var f := FileAccess.open(path, FileAccess.WRITE)
	f.store_string(text_of(data))
	f.close()


## The exact text the tool writes for a json file.
static func text_of(data: Dictionary) -> String:
	return JSON.stringify(data, "\t") + "\n"


static func sha256(bytes: PackedByteArray) -> String:
	var ctx := HashingContext.new()
	ctx.start(HashingContext.HASH_SHA256)
	ctx.update(bytes)
	return ctx.finish().hex_encode()


## Placed counts: {cover, ring, decor, breakables, structures, walls_inner, walls_outer}.
static func counts_of(out: Dictionary) -> Dictionary:
	var inner := 0
	var outer := 0
	for entry: Dictionary in out["structures"]["pieces"]:
		if String(entry["id"]).begins_with("InnerRing_"):
			inner += 1
		elif String(entry["id"]).begins_with("OuterRing_"):
			outer += 1
	return {
		"cover": (out["cover"]["pieces"] as Array).size(),
		"ring": (out["cover"]["ring_pieces"] as Array).size(),
		"decor": (out["cover"]["decor"] as Array).size(),
		"breakables": ((out["cover"] as Dictionary).get("breakables", []) as Array).size(),
		"structures": (out["structures"]["pieces"] as Array).size(),
		"walls_inner": inner,
		"walls_outer": outer,
	}


## Compass bearing (degrees) to the unit vector on the ground (x, z): 0 = north = -z, 90 = east = +x.
static func dir_of(bearing_deg: float) -> Vector2:
	var b := deg_to_rad(bearing_deg)
	return Vector2(sin(b), -cos(b))


## The unit vector 90 degrees clockwise of dir_of (to the right when facing out along the bearing).
static func right_of(bearing_deg: float) -> Vector2:
	var b := deg_to_rad(bearing_deg)
	return Vector2(cos(b), sin(b))


static func _r3(v: float) -> float:
	var s := snappedf(v, 0.001)
	return 0.0 if s == 0.0 else s  # no -0.0


## The citadel hill's height at (x, z): the flat top, then a smoothstep fall to 0 at radius_m.
static func hill_height(hill: Dictionary, x: float, z: float) -> float:
	var r := sqrt(x * x + z * z)
	var top := float(hill["top_radius_m"])
	var radius := float(hill["radius_m"])
	if r >= radius:
		return 0.0
	if r <= top:
		return float(hill["height_m"])
	var u := (r - top) / (radius - top)
	return float(hill["height_m"]) * (1.0 - u * u * (3.0 - 2.0 * u))


## The terrain of the map (a MapTerrain built from the generator's hill; the same object is saved as the heights).
static func terrain_of(map_def: Dictionary) -> MapTerrain:
	var block: Dictionary = map_def["terrain"]
	var hill: Dictionary = map_def["generator"]["hill"]
	var t := MapTerrain.new()
	t.size_m = float(block["size_m"])
	t.resolution_m = float(block["resolution_m"])
	t.samples = roundi(t.size_m / t.resolution_m) + 1
	t.max_piece_slope_deg = float(block.get("max_piece_slope_deg", 90.0))
	t.max_piece_float_m = float(block.get("max_piece_float_m", INF))
	var half := t.size_m * 0.5
	var heights := PackedFloat32Array()
	heights.resize(t.samples * t.samples)
	for iz in t.samples:
		var z := -half + iz * t.resolution_m
		for ix in t.samples:
			heights[iz * t.samples + ix] = hill_height(hill, -half + ix * t.resolution_m, z)
	t.heights = heights
	return t


## Everything except the paint, in memory: {cover, structures, landmarks (the three files), spawns,
## reserved_spots, terrain, problems, shortfalls, max_joint_gap_m, ground_rejects, extra (_extra_cover's result),
## breakables (_breakables' counts), chests (_chests' counts), cover_walls (coverable cover and ring pieces plus
## breakables)}. Touches no file
## except the type files it reads.
static func generate(map_def: Dictionary) -> Dictionary:
	var gen: Dictionary = map_def["generator"]
	var rng := RandomNumberGenerator.new()
	rng.seed = int(gen["seed"])
	var cover_cfg := DataRegistry.parse_quiet(COVER_TYPES)
	var kit_types: Dictionary = WorldKit.config()["types"]
	var terrain := terrain_of(map_def)
	var state := {
		"rng": rng,
		"gen": gen,
		"place": gen["placement"],
		"play_r": float(map_def["play_radius_m"]),
		"placed": [] as Array[Rect2],
		"keep": [] as Array,  # [Vector2 centre, float radius]: open ground kept free (spawns, anchors, J1 spots, gates)
		"terrain": terrain,
		"ground_rejects": 0,
		"problems": PackedStringArray(),
		"shortfalls": PackedStringArray(),
		"cover_types": cover_cfg["types"],
	}
	if gen.has("ground_contact"):  # M2 L2a: the 500 m map's placement rule against floating pieces (_contact_sink)
		state["contact"] = gen["ground_contact"]
	var structures: Array = []
	# 1. The two wall rings (free yaw on the side tangents), then the aqueducts, the citadel and the camps.
	var aqueducts: Array = gen["aqueducts"]
	var inner := _ring(state, "InnerRing_%03d", gen["inner_wall"], aqueducts, kit_types)
	var outer := _ring(state, "OuterRing_%03d", gen["outer_wall"], aqueducts, kit_types)
	structures.append_array(inner["pieces"])
	structures.append_array(outer["pieces"])
	var rings: Array = [inner, outer]
	# M2 L2a: a third ring on the Arx top (only with generator.arx_wall), after the two others.
	var arx_ring := {}
	if gen.has("arx_wall"):
		arx_ring = _ring(state, "ArxRing_%03d", gen["arx_wall"], aqueducts, kit_types)
		structures.append_array(arx_ring["pieces"])
		rings.append(arx_ring)
	var worst := 0.0
	for ring: Dictionary in rings:
		for joint: Dictionary in joint_gaps(ring["pieces"], kit_types):
			worst = maxf(worst, maxf(float(joint["inner"]), float(joint["outer"])))
	if worst > float(gen["wall"]["max_joint_gap_m"]):
		_note(state, "problems", "a wall joint gap of %.3f m exceeds %s m" % [worst, str(gen["wall"]["max_joint_gap_m"])])
	for aq: Dictionary in aqueducts:
		structures.append_array(_aqueduct(aq))
	for entry: Dictionary in gen["citadel"]["pieces"]:
		structures.append({"id": entry["id"], "type": entry["type"], "at": [float(entry["at"][0]), 0.0, float(entry["at"][1])], "yaw": float(entry["yaw"])})
	var camps: Dictionary = gen["camps"]
	var camp_centres: Array[Vector2] = []
	for c in (camps["names"] as Array).size():
		var centre := dir_of(float(camps["first_bearing_deg"]) + 60.0 * c) * float(camps["radius_m"])
		centre = Vector2(_r3(centre.x), _r3(centre.y))
		camp_centres.append(centre)
		for i in (camps["barracks"] as Array).size():
			var p: Array = camps["barracks"][i]
			structures.append({"id": "Castra%d_Barracks_%d" % [c + 1, i], "type": "barracks", "at": [_r3(centre.x + float(p[0])), 0.0, _r3(centre.y + float(p[1]))], "yaw": 0.0})
		for i in (camps["tents"] as Array).size():
			var p: Array = camps["tents"][i]
			structures.append({"id": "Castra%d_Tent_%d" % [c + 1, i], "type": "tent", "at": [_r3(centre.x + float(p[0])), 0.0, _r3(centre.y + float(p[1]))], "yaw": 0.0})
	for entry: Dictionary in structures:
		var at := Vector3(float(entry["at"][0]), 0.0, float(entry["at"][2]))
		(state["placed"] as Array[Rect2]).append(WorldKit.footprint(kit_types[entry["type"]], at, float(entry["yaw"])))
	# 2. Spawns, landmarks (their anchors) and the J1 spots: open ground the random pieces keep clear of.
	var spawns := _spawns(gen["spawns"])
	var place: Dictionary = gen["placement"]
	for id: String in spawns:
		(state["keep"] as Array).append([Vector2(float(spawns[id][0]), float(spawns[id][2])), float(place["spawn_clear_m"])])
	var landmarks := _landmarks(gen, camp_centres, terrain)
	for landmark: Dictionary in landmarks:
		(state["keep"] as Array).append([Vector2(float(landmark["anchor"][0]), float(landmark["anchor"][2])), float(place["anchor_clear_m"])])
	var spots := _reserved(gen)
	for spot: Dictionary in spots:
		(state["keep"] as Array).append([Vector2(float(spot["at"][0]), float(spot["at"][1])), float(gen["reserved"]["clear_m"])])
	for g: Dictionary in inner["gates"] + outer["gates"]:
		for side: float in [-1.0, 1.0]:
			(state["keep"] as Array).append([(g["at"] as Vector2) + (g["normal"] as Vector2) * side * 4.0, float(gen["gates"]["clear_m"])])
	var cover: Array = []
	var ring_pieces: Array = []
	var decor: Array = []
	# M2 L2a: the 500 m map's laid-out areas (Arx ring keeps, camp extras, town grid, farmsteads, field wall runs, the
	# outside strip), placed before every random pass so the random pieces avoid them. Nothing without their keys.
	var l500 := _layout_500(state, structures, cover, ring_pieces, camp_centres, arx_ring, landmarks, kit_types)
	# 3. Random pieces, densest where fights happen (camps), moderate on the citadel, sparse in the fields.
	var cit: Dictionary = gen["citadel"]
	var hill: Dictionary = gen["hill"]
	var templates := _decor_templates(cover_cfg)
	for entry: Dictionary in cit["arches"]:
		var t: Dictionary = templates["arch"]
		var at := Vector2(float(entry["at"][0]), float(entry["at"][1]))
		decor.append({"id": "Decor_%03d" % decor.size(), "kind": "arch", "size": (t["size"] as Array).duplicate(), "at": [at.x, float(t["at"][1]), at.y], "yaw": float(entry["yaw"])})
		(state["placed"] as Array[Rect2]).append(_box_rect(at, LowpolyKit.vec(t["size"]), float(entry["yaw"])))
	_cover(state, cover, "Cover_%03d", cit["cover_types"], int(cit["cover_top"]), _annulus(0.0, float(cit["cover_top_radius_m"])), "citadel top")
	_cover(state, cover, "Cover_%03d", cit.get("slope_cover_types", cit["cover_types"]), int(cit["cover_slope"]), _annulus(float(hill["top_radius_m"]), float(hill["radius_m"]) + 5.0), "citadel slopes")
	_decor(state, decor, templates["rock"], int(cit["rocks"]), _annulus(float(hill["radius_m"]) - 10.0, float(hill["radius_m"]) + 15.0), "citadel rocks")
	var half := float(camps["half_size_m"])
	for c in camp_centres.size():
		var block := Rect2(camp_centres[c] - Vector2(half, half), Vector2(half, half) * 2.0)
		_stakes(state, structures, "Castra%d_Stakes_%%d" % (c + 1), int(camps["stake_rows"]), _rect_sampler(block), kit_types, "camp %d stakes" % (c + 1), block)
		_cover(state, cover, "Cover_%03d", camps["cover_types"], int(camps["cover"]), _rect_sampler(block), "camp %d cover" % (c + 1), block)
	var gates_cfg: Dictionary = gen["gates"]
	for ring_index in 2:
		var ring_gates: Array = inner["gates"] if ring_index == 0 else outer["gates"]
		for g: Dictionary in ring_gates:
			var sides: Array = [1.0, -1.0] if ring_index == 0 else [1.0]  # outer gates: the field side only
			for side: float in sides:
				var mid := (g["at"] as Vector2) + (g["normal"] as Vector2) * side * float(gates_cfg["reach_m"])
				var along := g["tangent"] as Vector2
				var sampler := func(r: RandomNumberGenerator) -> Vector2:
					return mid + along * r.randf_range(-float(gates_cfg["lateral_m"]), float(gates_cfg["lateral_m"])) + (g["normal"] as Vector2) * side * r.randf_range(-4.0, 4.0)
				_cover(state, cover, "Cover_%03d", camps["cover_types"], int(gates_cfg["cover_per_side"]), sampler, "gate %s cover" % g["name"])
	var fields: Dictionary = gen["fields"]
	var field_ring := _field_ring(state, float(fields["from_m"]), float(fields["to_m"]))
	_stakes(state, structures, "Field_Stakes_%d", int(fields["stake_rows"]), field_ring, kit_types, "field stakes")
	_cover(state, ring_pieces, "Ring_%03d", fields["cover_types"], int(fields["cover"]), field_ring, "field cover")
	_decor(state, decor, templates["rock"], int(fields["rocks"]), field_ring, "field rocks")
	# 4. M2 L1b: the extra static cover ("extra_cover"), appended after every earlier pass, so the earlier pieces and
	# their random draws stay exactly as they were.
	var extra := _extra_cover(state, cover, ring_pieces, camp_centres, inner, outer)
	# 5. M2 L1b: the breakable crates and barrels ("props"), appended after the extra cover. Every breakable is a
	# cover wall until it breaks.
	var props := _breakables(state, camp_centres, inner, outer)
	_breakables_500(state, props, l500)
	var breakables: Array = props["entries"]
	var walls := breakables.size()
	for list: Array in [cover, ring_pieces]:
		for entry: Dictionary in list:
			if bool((cover_cfg["types"][entry["type"]] as Dictionary).get("coverable", false)):
				walls += 1
	if walls > int(gen["max_cover_walls"]):
		_note(state, "problems", "%d cover walls exceed max_cover_walls %d" % [walls, int(gen["max_cover_walls"])])
	# 6. M2 L1b: the loot chests ("props.chests"), appended after the breakables. Permanent bodies under Nav, never
	# cover walls (so not counted against max_cover_walls).
	var chest_pass := _chests(state, camp_centres)
	_chests_500(state, chest_pass, l500)
	# 7. M2L1c: a guard beside each aqueduct ramp's foot ("ramp_guard", OQ-MAP-CLEAR), appended after every earlier
	# pass, so the earlier pieces and their random draws stay exactly as they were.
	_ramp_guards(state, structures, kit_types)
	# 8. M2L1c: the doors and gates ("doors", OQ-PROPS-DOOR) in the existing barracks doorways and gate openings,
	# appended after every earlier pass (their start-state draws come last), so nothing earlier moves.
	var door_pass := _doors(state, structures, kit_types)
	# 9. M2 L1c commit 5: the ladders ("ladders", OQ-PROPS-LADDER) on the barracks end walls, appended after the door
	# pass; no random draw, so nothing earlier moves.
	var ladder_pass := _ladders(state, structures, kit_types)
	if gen.has("cx2_world"):
		_cx2_landmarks_and_dressing(state, structures, kit_types, l500)
	var note := String(gen.get("file_note", NOTE))  # M2 L2a: a map's own note (the 1 km map has none: NOTE)
	var cover_file := {"version": 1, "_placeholder": true, "_note": note, "pieces": cover, "ring_pieces": ring_pieces, "decor": decor}
	if gen.has("props"):
		cover_file["breakables"] = breakables
		if (gen["props"] as Dictionary).has("chests"):
			cover_file["chests"] = chest_pass["entries"]
	if gen.has("doors"):
		cover_file["doors"] = door_pass["entries"]
	if gen.has("ladders"):
		cover_file["ladders"] = ladder_pass["entries"]
	var structure_file := {"version": 1, "_placeholder": true, "_note": note, "pieces": structures}
	var landmark_file := {
		"version": 1,
		"_placeholder": true,
		"_todo": String(gen.get("landmarks_todo", "OQ-ALESIA-LAYOUT: the 1 km map's landmark names and places are proposals for Shibi; generated by tools/gen_alesia.gd, do not edit by hand.")),
		"_format": "As data/maps/alesia_landmarks.json: at = [x, z] centre, radius_m = the area that counts as the place, anchor = [x, y, z] on open ground inside it (y = the terrain height). Loot clusters and the ground paint name landmarks by id.",
		"_rules_note": String(gen.get("landmarks_rules_note", "")) if gen.has("landmarks_rules_note") else "No \"rules\" block: alesia's landmark rules (tall_minimum, max_open_stretch_m 12 m between anchors, ...) are tested on alesia_section only (tests/test_world_ring.gd). On this sparse 1 km map the routes between landmarks run hundreds of metres over open fields and camp ring by design; a per-map rules block is a proposal for when Shibi decides the cover along routes.",
		"landmarks": landmarks,
	}
	return {
		"cover": cover_file,
		"structures": structure_file,
		"landmarks": landmark_file,
		"spawns": spawns,
		"reserved_spots": spots,
		"terrain": terrain,
		"problems": state["problems"],
		"shortfalls": state["shortfalls"],
		"max_joint_gap_m": worst,
		"ground_rejects": int(state["ground_rejects"]),
		"extra": extra,
		"breakables": props["counts"],
		"chests": chest_pass["counts"],
		"doors": door_pass["counts"],
		"ladders": ladder_pass["counts"],
		"cover_walls": walls,
		"l500": l500,
		"bare": _bare_squares(state) if gen.has("density_check") else [],
		"contact_rejects": int(state.get("contact_rejects", 0)),
	}


## The paint and its inputs hash, from the round-tripped files (what the runtime reads): {image, hash}.
static func paint_of(map_def: Dictionary, out: Dictionary) -> Dictionary:
	var settings := GroundPaint.settings_for(map_def)
	var size := float(map_def["terrain"]["size_m"])
	var landmarks: Array = JSON.parse_string(text_of(out["landmarks"]))["landmarks"]
	var trodden := trodden_of(JSON.parse_string(text_of(out["cover"])), JSON.parse_string(text_of(out["structures"])))
	var key := "gen_alesia:" + map_path_of(String(map_def.get("id", "alesia_1km")))  # a cache key only
	GroundPaint.forget(key)
	var image := GroundPaint.build(key, size, landmarks, trodden, settings)
	GroundPaint.forget(key)
	return {"image": image, "hash": GroundPaint.inputs_hash(size, landmarks, trodden, settings)}


## The trodden points the builder uses (ArtBuilder._paint_ground: cover, ring and structure bodies, in that order;
## M2 L1b: the cover bodies are the pieces, then the breakables).
static func trodden_of(cover_file: Dictionary, structure_file: Dictionary) -> PackedVector2Array:
	var out := PackedVector2Array()
	for list: Array in [cover_file["pieces"], cover_file.get("breakables", []), cover_file.get("ring_pieces", []), structure_file["pieces"]]:
		for entry: Dictionary in list:
			out.append(Vector2(float(entry["at"][0]), float(entry["at"][2])))
	return out


## One polygonal wall ring: `sides` straight sides whose middles lie at `radius_m` (the apothem), side k's middle
## at bearing k * 360 / sides. Gates and towers sit on the middles of the sides at their bearings; the rest of each
## side is filled with wall pieces spaced at most a piece length apart. Each side's run is lengthened past both
## corners by half_thickness * tan(180 / sides), so the outer faces of neighbouring sides meet in a mitre and the
## inner faces overlap. Every `stair_every`-th wall piece is a wall_stair (its stair on the inner side) unless it
## ends a side or lies within stair_clear_m of a gate, a tower or an aqueduct. Returns {pieces (ring order),
## gates: [{name, at, normal, tangent}]}.
static func _ring(state: Dictionary, id_format: String, cfg: Dictionary, aqueducts: Array, kit_types: Dictionary) -> Dictionary:
	var wall: Dictionary = state["gen"]["wall"]
	var length := float(wall["piece_length_m"])
	var sides := int(cfg["sides"])
	var apothem := float(cfg["radius_m"])
	var step := 360.0 / sides
	var half_side := apothem * tan(PI / sides)
	var extend := float(wall["half_thickness_m"]) * tan(PI / sides)
	var gate_bearings: Array = cfg["gate_bearings_deg"]
	var tower_bearings: Array = cfg["tower_bearings_deg"]
	var tower_def: Dictionary = kit_types["watchtower"]
	var tower_rect := WorldKit.footprint(tower_def, Vector3.ZERO, 180.0)  # flipped: ramp foot inwards
	var pieces: Array = []
	var gates: Array = []
	var clear_points: Array[Vector2] = []
	for aq: Dictionary in aqueducts:
		var line := right_of(float(aq["bearing_deg"])) * float(aq["offset_m"])
		clear_points.append(line + dir_of(float(aq["bearing_deg"])) * apothem)
	var wall_index := 0
	for k in sides:
		var bearing := k * step
		var normal := dir_of(bearing)
		var tangent := right_of(bearing)
		var middle := normal * apothem
		var slots: Array = []  # [u0, u1, type, name, yaw offset]
		for i in gate_bearings.size():
			if is_equal_approx(fposmod(float(gate_bearings[i]), 360.0), bearing):
				slots.append([-length * 0.5, length * 0.5, "gate", String(cfg["gate_names"][i]), 0.0])
				gates.append({"name": String(cfg["gate_names"][i]), "at": middle, "normal": normal, "tangent": tangent})
				clear_points.append(middle)
		for tb: Variant in tower_bearings:
			if is_equal_approx(fposmod(float(tb), 360.0), bearing):
				# Flipped (yaw + 180, ramp foot inwards): tower_rect is already its footprint in the side's frame.
				slots.append([tower_rect.position.x, tower_rect.end.x, "watchtower", "", 180.0])
				clear_points.append(middle)
		var cuts: Array = [-half_side - extend]
		for slot: Array in slots:
			cuts.append(slot[0])
			cuts.append(slot[1])
		cuts.append(half_side + extend)
		var side_entries: Array = []  # [u, type, name, yaw offset]
		for s in range(0, cuts.size(), 2):
			var a: float = cuts[s]
			var b: float = cuts[s + 1]
			var n := maxi(1, ceili((b - a) / length - 0.000001))
			for i in n:
				var u := (a + b) * 0.5 if n == 1 else a + length * 0.5 + i * (b - a - length) / (n - 1)
				side_entries.append([u, "wall_walk", "", 0.0])
			if s / 2 < slots.size():
				var slot: Array = slots[s / 2]
				side_entries.append([0.0, slot[2], slot[3], slot[4]])
		for e in side_entries.size():
			var entry: Array = side_entries[e]
			var at := middle + tangent * float(entry[0])
			var type := String(entry[1])
			if type == "wall_walk":
				var stair := wall_index % int(wall["stair_every"]) == int(wall["stair_every"]) / 2 and e > 0 and e < side_entries.size() - 1
				for p in clear_points:
					stair = stair and p.distance_to(at) > float(wall["stair_clear_m"])
				if stair:
					type = "wall_stair"
				wall_index += 1
			var yaw := fposmod(-bearing + float(entry[3]), 360.0)
			var piece := {"id": id_format % pieces.size(), "type": type, "at": [_r3(at.x), 0.0, _r3(at.y)], "yaw": snappedf(yaw, 0.0001)}
			if String(entry[2]) != "":
				piece["name"] = entry[2]
			pieces.append(piece)
	return {"pieces": pieces, "gates": gates}


## M2L1: the joint gaps of one ring's pieces in ring order (the last joins the first): for each consecutive pair
## P, Q and each face line of P (the wall's inner and outer face, half_thickness from its centre line), the
## distance from P's end on that line (the end nearer Q) to Q's colliders, or from Q's facing end to P's colliders,
## whichever is smaller (0 when they touch or overlap). [{a, b, inner, outer}]. Shared by the generator and
## tests/test_alesia_1km_data.gd.
static func joint_gaps(pieces: Array, kit_types: Dictionary, half_thickness := 1.2) -> Array:
	var out: Array = []
	for i in pieces.size():
		var p: Dictionary = pieces[i]
		var q: Dictionary = pieces[(i + 1) % pieces.size()]
		var faces := {}
		for face: float in [-1.0, 1.0]:  # local -z = outer, +z = inner for a wall piece (flipped pieces swap)
			var pe := _face_end(p, kit_types, face, q, half_thickness)
			var qe := _face_end(q, kit_types, face, p, half_thickness)
			faces[face] = minf(_distance_to_piece(pe, q, kit_types), _distance_to_piece(qe, p, kit_types))
		out.append({"a": p["id"], "b": q["id"], "outer": faces[-1.0], "inner": faces[1.0]})
	return out


## The end of piece `p` on its face line `face` (-1 outer, +1 inner, in the ring's sense) nearer `other`.
static func _face_end(p: Dictionary, kit_types: Dictionary, face: float, other: Dictionary, half_thickness: float) -> Vector2:
	var yaw := deg_to_rad(float(p["yaw"]))
	var turn := Basis(Vector3.UP, yaw)
	var at := Vector3(float(p["at"][0]), 0.0, float(p["at"][2]))
	# A piece turned by 180 relative to its side (a tower) has its outer face on local +z.
	var outward := _outward_of(p)
	var local_face := face * (1.0 if (turn * Vector3(0, 0, -1)).dot(Vector3(outward.x, 0, outward.y)) > 0.0 else -1.0)
	var target := Vector3(float(other["at"][0]), 0.0, float(other["at"][2]))
	var best := Vector2.ZERO
	var best_d := INF
	var span := _band_span(kit_types[p["type"]], local_face * half_thickness)
	for x: float in [span.x, span.y]:
		var w := at + turn * Vector3(x, 0.0, local_face * half_thickness)
		var d := Vector2(w.x, w.z).distance_to(Vector2(target.x, target.z))
		if d < best_d:
			best_d = d
			best = Vector2(w.x, w.z)
	return best


## The outward ring normal at a ring piece (from the centre through its origin).
static func _outward_of(p: Dictionary) -> Vector2:
	return Vector2(float(p["at"][0]), float(p["at"][2])).normalized()


## [x0, x1]: the local x range a piece's colliders cover along its face line z = `line`.
static func _band_span(definition: Dictionary, line: float) -> Vector2:
	var lo := INF
	var hi := -INF
	for entry: Dictionary in definition["colliders"]:
		var rect := _collider_rect(entry)
		if rect.position.y <= line + 0.0001 and rect.end.y >= line - 0.0001:
			lo = minf(lo, rect.position.x)
			hi = maxf(hi, rect.end.x)
	return Vector2(lo, hi)


## The XZ bounds of one collider entry in piece space.
static func _collider_rect(entry: Dictionary) -> Rect2:
	var rect := Rect2()
	var first := true
	for c in WorldKit.collider_corners(entry):
		rect = Rect2(Vector2(c.x, c.z), Vector2.ZERO) if first else rect.expand(Vector2(c.x, c.z))
		first = false
	return rect


## Distance on the ground from `point` to the nearest collider of structure piece `p` (0 inside one).
static func _distance_to_piece(point: Vector2, p: Dictionary, kit_types: Dictionary) -> float:
	var yaw := deg_to_rad(float(p["yaw"]))
	var local3 := Basis(Vector3.UP, yaw).inverse() * Vector3(point.x - float(p["at"][0]), 0.0, point.y - float(p["at"][2]))
	var local := Vector2(local3.x, local3.z)
	var best := INF
	for entry: Dictionary in kit_types[p["type"]]["colliders"]:
		best = minf(best, WorldRing.rect_distance(local, _collider_rect(entry)))
	return best


## One aqueduct: spans every 10 m along its bearing, centred on the inner wall line and outwards, with a ramp at
## each end rising towards the spans.
static func _aqueduct(aq: Dictionary) -> Array:
	var bearing := float(aq["bearing_deg"])
	var out_dir := dir_of(bearing)
	var line := right_of(bearing) * float(aq["offset_m"])
	var span_yaw := _yaw_towards(out_dir)
	var pieces: Array = []
	var first := -int(aq["spans_in"])
	var last := int(aq["spans_out"])
	var base := String(aq["id"]).capitalize().replace(" ", "")
	for k in range(first, last + 1):
		var at := line + out_dir * (float(aq["inner_m"]) + SPAN_M * k)
		pieces.append({"id": "%s_Span_%02d" % [base, k - first], "type": "aqueduct_span", "at": [_r3(at.x), 0.0, _r3(at.y)], "yaw": span_yaw})
	var inner_at := line + out_dir * (float(aq["inner_m"]) + SPAN_M * first - RAMP_OFFSET_M)
	var outer_at := line + out_dir * (float(aq["inner_m"]) + SPAN_M * last + RAMP_OFFSET_M)
	pieces.append({"id": "%s_Ramp_In" % base, "type": "aqueduct_ramp", "at": [_r3(inner_at.x), 0.0, _r3(inner_at.y)], "yaw": _yaw_towards(out_dir)})
	pieces.append({"id": "%s_Ramp_Out" % base, "type": "aqueduct_ramp", "at": [_r3(outer_at.x), 0.0, _r3(outer_at.y)], "yaw": _yaw_towards(-out_dir)})
	return pieces


## M2L1c (generator.ramp_guard, OQ-MAP-CLEAR): guard pieces flush along both long sides of every aqueduct ramp,
## from its foot up the slope. Measured (runs/M2L1C): the saved navmesh joins the ground to a ramp's side near
## its foot, where the side is a step the bake connects (agent_max_climb 0.25 m at cell_height 0.25 m) but a pawn
## (max step 0.12 m, data/physics_baseline.json) cannot climb, so a path from beside the foot runs into the side and
## the walker stands there. A guard closes that side in physics and in the bake (it is a structure under Nav), so
## the path enters at the foot. ramp_guard: type (a kit type whose footprint's long axis is local x), along_m (the
## stretch from the foot that is guarded, in whole guard lengths), overlap_m (into the ramp, so no slit is left).
## Pieces "<ramp id>_Guard_<L|R><k>" take the ramp's yaw. A guard closer than placement.minimum_gap_m to any other
## footprint (its own ramp and every guard aside) is a problem, so a guard never makes a slit or sits on a piece.
static func _ramp_guards(state: Dictionary, structures: Array, kit_types: Dictionary) -> void:
	var gen: Dictionary = state["gen"]
	if not gen.has("ramp_guard"):
		return
	var cfg: Dictionary = gen["ramp_guard"]
	var type := String(cfg["type"])
	var guard_def: Dictionary = kit_types[type]
	var local_guard := WorldKit.footprint(guard_def, Vector3.ZERO, 0.0)
	var local_ramp := WorldKit.footprint(kit_types["aqueduct_ramp"], Vector3.ZERO, 0.0)
	var length := local_guard.size.x
	var per_side := maxi(int(ceil(float(cfg["along_m"]) / length - 0.001)), 1)
	var overlap := float(cfg["overlap_m"])
	var min_gap := float(gen["placement"]["minimum_gap_m"])
	var own: Array[Rect2] = []
	var guards: Array = []
	for entry: Dictionary in structures:
		if String(entry["type"]) != "aqueduct_ramp":
			continue
		var at := Vector3(float(entry["at"][0]), 0.0, float(entry["at"][2]))
		var yaw := float(entry["yaw"])
		var turn := Basis(Vector3.UP, deg_to_rad(yaw))
		own.append(WorldKit.footprint(kit_types["aqueduct_ramp"], at, yaw))
		for side: float in [-1.0, 1.0]:
			# Local frame: +x up the slope (the foot at local_ramp.position.x), the sides at local z = the rect's edges.
			var edge := local_ramp.end.y if side > 0.0 else local_ramp.position.y
			var z := edge + side * (local_guard.size.y * 0.5 - overlap) - local_guard.get_center().y
			for k in per_side:
				var x := local_ramp.position.x + length * (float(k) + 0.5) - local_guard.get_center().x
				var p := at + turn * Vector3(x, 0.0, z)
				guards.append({"id": "%s_Guard_%s%d" % [entry["id"], "L" if side < 0.0 else "R", k], "type": type, "at": [_r3(p.x), 0.0, _r3(p.z)], "yaw": yaw})
	var placed: Array[Rect2] = state["placed"]
	var guard_rects: Array[Rect2] = []
	for g: Dictionary in guards:
		guard_rects.append(WorldKit.footprint(guard_def, Vector3(float(g["at"][0]), 0.0, float(g["at"][2])), float(g["yaw"])))
	for i in guards.size():
		for other in placed:
			if own.has(other) or guard_rects.has(other):
				continue
			if WorldRing.rect_gap(guard_rects[i], other) < min_gap:
				_note(state, "problems", "ramp guard %s is %.2f m from another footprint (minimum_gap_m %s)" % [guards[i]["id"], WorldRing.rect_gap(guard_rects[i], other), str(min_gap)])
	structures.append_array(guards)
	placed.append_array(guard_rects)


## M2L1c (generator.doors, OQ-PROPS-DOOR): one door entry per listed opening of every structure piece of a kind's kit
## type, in a fixed order (kind "door" then "gate", pieces in structure order, openings in the listed order). No new
## doorway is cut: an opening is the kit type's "open" box (alesia_structures.json, read-only), so the door's box is
## that opening's width and height and the kind's thickness_m, centred on it, turned by the piece's yaw. Doors slide
## (scripts/props/door.gd): slide "inner" = one leaf sliding along local x towards the piece's centre ("left" =
## towards -x, "right" = +x; an opening at x 0 slides right); "apart" = two half leaves, one each way. Every pocket
## (where an open leaf rests: its own width past the opening's edge) must lie inside the piece's colliders in the
## opening's plane (sampled every 0.1 m at three heights), so an open leaf sits inside a wall, and must stay within
## gates.clear_m of the opening's centre for a gate (problems otherwise). start: one seeded draw per entry, in
## order, after every other pass: "open" when it is below start_open_share. Ids "Door_%03d" / "Gate_%03d". `at` is the
## file position (y over flat ground, as every cover-file entry; the builder lifts it), and the terrain under the door
## must equal the terrain under its piece's origin (a problem otherwise). Returns {entries, counts: {door, gate, open,
## closed}}.
static func _doors(state: Dictionary, structures: Array, kit_types: Dictionary) -> Dictionary:
	var entries: Array = []
	var counts := {"door": 0, "gate": 0, "open": 0, "closed": 0}
	var gen: Dictionary = state["gen"]
	if not gen.has("doors") or not bool((gen["doors"] as Dictionary).get("enabled", true)):
		return {"entries": entries, "counts": counts}
	var cfg: Dictionary = gen["doors"]
	var rng: RandomNumberGenerator = state["rng"]
	var terrain: MapTerrain = state["terrain"]
	var problems: PackedStringArray = state["problems"]
	for kind: String in ["door", "gate"]:
		if not cfg.has(kind) or not bool((cfg[kind] as Dictionary).get("enabled", true)):
			continue
		var k: Dictionary = cfg[kind]
		var type := String(k["type"])
		var openings: Array = (kit_types[type] as Dictionary).get("open", [])
		for piece: Dictionary in structures:
			if String(piece["type"]) != type or not id_matches(String(piece["id"]), k.get("id_patterns", null)):
				continue
			var yaw := float(piece["yaw"])
			var turn := Basis(Vector3.UP, deg_to_rad(yaw))
			var origin := LowpolyKit.vec(piece["at"])
			for index: Variant in k["openings"]:
				var o: Dictionary = openings[int(index)]
				var local := LowpolyKit.vec(o["at"])
				var hole := LowpolyKit.vec(o["size"])
				var at := origin + turn * local
				var slide := "apart" if String(k["slide"]) == "apart" else ("left" if local.x > 0.0 else "right")
				var thickness := float(k["thickness_m"])
				var entry := {
					"id": ("Door_%03d" if kind == "door" else "Gate_%03d") % int(counts[kind]),
					"kind": kind,
					"piece": String(piece["id"]),
					"at": [_r3(at.x), _r3(at.y), _r3(at.z)],
					"yaw": yaw,
					"size": [float(o["size"][0]), float(o["size"][1]), thickness],  # the file's numbers (a Vector3 is float32)
					"slide": slide,
				}
				if absf(terrain.height_at(at.x, at.z) - terrain.height_at(origin.x, origin.z)) > 0.01:
					problems.append("%s: the ground under the door differs from the ground under %s" % [entry["id"], piece["id"]])
				var pocket := door_pocket_problem(kit_types[type], local, hole, slide)
				if pocket != "":
					problems.append("%s: %s" % [entry["id"], pocket])
				if kind == "gate":
					var far := Vector2(hole.x, thickness * 0.5).length()  # the outer edge of an open leaf
					if far > float(gen["gates"]["clear_m"]):
						problems.append("%s: an open leaf reaches %.2f m from the opening, past gates.clear_m %s" % [entry["id"], far, str(gen["gates"]["clear_m"])])
				entries.append(entry)
				counts[kind] = int(counts[kind]) + 1
	for entry: Dictionary in entries:
		var share := float((cfg[String(entry["kind"])] as Dictionary)["start_open_share"])
		entry["start"] = "open" if rng.randf() < share else "closed"
		counts[entry["start"]] = int(counts[entry["start"]]) + 1
	return {"entries": entries, "counts": counts}


## M2 L2a: true when `patterns` is null (no filter: every piece, as before) or `id` matches one of its globs
## (String.match: "*" any run, "?" one character), e.g. doors.door.id_patterns ["Castra*", "Villa*"].
static func id_matches(id: String, patterns: Variant) -> bool:
	if patterns == null:
		return true
	for p: Variant in patterns:
		if id.match(String(p)):
			return true
	return false


## M2L1c: "" when every pocket of a sliding door lies inside the colliders of its piece `definition` (piece frame):
## the stretch of one leaf width past the opening's edge on each side a leaf slides to ("left" -x, "right" +x,
## "apart" both, each a half leaf), on the opening's centre plane, sampled every 0.1 m at three heights of the
## opening; otherwise the first point outside. Shared by the generator and tests/test_props_doors.gd.
static func door_pocket_problem(definition: Dictionary, opening_at: Vector3, opening_size: Vector3, slide: String) -> String:
	var leaf := opening_size.x / (2.0 if slide == "apart" else 1.0)
	var sides: Array[float] = []
	if slide == "apart" or slide == "left":
		sides.append(-1.0)
	if slide == "apart" or slide == "right":
		sides.append(1.0)
	var boxes: Array[AABB] = []
	for c: Dictionary in definition.get("colliders", []):
		if String(c.get("shape", "box")) == "box":
			var s := LowpolyKit.vec(c["size"])
			boxes.append(AABB(LowpolyKit.vec(c["at"]) - s * 0.5, s).grow(0.001))
	for side: float in sides:
		var edge := opening_at.x + side * opening_size.x * 0.5
		var steps := maxi(ceili(leaf / 0.1), 1)
		for i in steps + 1:
			var x := edge + side * leaf * float(i) / float(steps)
			for f: float in [0.1, 0.5, 0.9]:
				var p := Vector3(x, opening_at.y - opening_size.y * 0.5 + opening_size.y * f, opening_at.z)
				var inside := false
				for b: AABB in boxes:
					if b.has_point(p):
						inside = true
						break
				if not inside:
					return "the pocket point %s is outside every collider of the piece" % p
	return ""


## M2 L1c commit 5 (generator.ladders, OQ-PROPS-LADDER): one ladder per structure piece of kit type `type` (pieces in
## structure order), on the first end wall in `ends` that can take one; no random draw. From the kit type's colliders
## (read-only): the roof = the box with the highest top (the ledge top = its top, the ladder plane = its edge on that
## end, the eave), the end wall = the box across x on that end farthest out (its outer face must not lie in front of
## the plane). An end can take a ladder when no "open" box (doorway, window) overlaps that end wall, the ladder's width
## fits the wall, the top-step point (top_step_m from the plane onto the roof, at the ledge top) lies a pawn radius
## (Ladder.PAWN_RADIUS_M) inside the roof slab, and the clearance (from the plane out front_clear_m, across width_m +
## side_clear_m each side) overlaps no other footprint in state.placed (the piece's own aside). The ground under the
## foot must equal the ground under the piece's origin (a problem otherwise, as for doors). Entries {id "Ladder_%03d",
## piece, at (the foot, y 0 over flat ground: the builder lifts it), yaw (the climber's facing, into the wall), height,
## width, top}. A piece with no end free is a problem naming it. Returns {entries, counts: {ladders, blocks,
## first_end, other_end, none}}.
static func _ladders(state: Dictionary, structures: Array, kit_types: Dictionary) -> Dictionary:
	var entries: Array = []
	var counts := {"ladders": 0, "blocks": 0, "first_end": 0, "other_end": 0, "none": 0}
	var gen: Dictionary = state["gen"]
	if not gen.has("ladders") or not bool((gen["ladders"] as Dictionary).get("enabled", true)):
		return {"entries": entries, "counts": counts}
	var cfg: Dictionary = gen["ladders"]
	var type := String(cfg["type"])
	var definition: Dictionary = kit_types[type]
	var terrain: MapTerrain = state["terrain"]
	var problems: PackedStringArray = state["problems"]
	var placed: Array[Rect2] = state["placed"]
	var ends: Array = cfg["ends"]
	for piece: Dictionary in structures:
		if String(piece["type"]) != type or not id_matches(String(piece["id"]), cfg.get("id_patterns", null)):
			continue
		counts["blocks"] = int(counts["blocks"]) + 1
		var origin := LowpolyKit.vec(piece["at"])
		var yaw := float(piece["yaw"])
		var own := WorldKit.footprint(definition, origin, yaw)
		var why: Array[String] = []
		var chosen := {}
		for k in ends.size():
			var spot := ladder_spot(definition, float(ends[k]), cfg)
			if spot.has("problem"):
				why.append("end %s: %s" % [str(ends[k]), spot["problem"]])
				continue
			var clear := _local_rect(origin, yaw, spot["clear"])
			var blocked := ""
			for other in placed:
				if other == own:
					continue
				if clear.intersects(other):
					blocked = "the clearance %s meets the footprint %s" % [clear, other]
					break
			if blocked != "":
				why.append("end %s: %s" % [str(ends[k]), blocked])
				continue
			chosen = spot
			counts["first_end" if k == 0 else "other_end"] = int(counts["first_end" if k == 0 else "other_end"]) + 1
			break
		if chosen.is_empty():
			counts["none"] = int(counts["none"]) + 1
			problems.append("%s: no end wall can take a ladder (%s)" % [piece["id"], "; ".join(why)])
			continue
		var turn := Basis(Vector3.UP, deg_to_rad(yaw))
		var foot := origin + turn * (chosen["foot"] as Vector3)
		var top := origin + turn * (chosen["top"] as Vector3)
		var into := turn * (chosen["into"] as Vector3)
		var entry := {
			"id": "Ladder_%03d" % int(counts["ladders"]),
			"piece": String(piece["id"]),
			"at": [_r3(foot.x), _r3(foot.y), _r3(foot.z)],
			"yaw": _r3(fposmod(rad_to_deg(atan2(-into.x, -into.z)), 360.0)),
			"height": _r3(float(chosen["height"])),
			"width": float(cfg["width_m"]),
			"top": [_r3(top.x), _r3(top.y), _r3(top.z)],
		}
		if absf(terrain.height_at(foot.x, foot.z) - terrain.height_at(origin.x, origin.z)) > 0.01:
			problems.append("%s: the ground under the ladder's foot differs from the ground under %s" % [entry["id"], piece["id"]])
		entries.append(entry)
		counts["ladders"] = int(counts["ladders"]) + 1
	return {"entries": entries, "counts": counts}


## M2 L1c commit 5: where a ladder goes on end `end` (+1 = local +x, -1 = -x) of kit piece `definition`, in the
## piece's frame: {foot, top, into (the climber's facing), height, clear: [x0, x1, z0, z1] (the clearance rectangle)}, or
## {problem} (see _ladders). Shared by the generator and tests/test_props_ladders.gd.
static func ladder_spot(definition: Dictionary, end: float, cfg: Dictionary) -> Dictionary:
	var roof := {}
	var roof_top := -INF
	var wall := {}
	for c: Dictionary in definition.get("colliders", []):
		if String(c.get("shape", "box")) != "box":
			continue
		var s := LowpolyKit.vec(c["size"])
		var a := LowpolyKit.vec(c["at"])
		if a.y + s.y * 0.5 > roof_top:
			roof_top = a.y + s.y * 0.5
			roof = c
		if s.z > s.x and a.x * end > 0.0 and (wall.is_empty() or absf(a.x) > absf(float(wall["at"][0]))):
			wall = c
	if roof.is_empty() or wall.is_empty():
		return {"problem": "no roof box or no end wall box"}
	var rs := LowpolyKit.vec(roof["size"])
	var ra := LowpolyKit.vec(roof["at"])
	var ws := LowpolyKit.vec(wall["size"])
	var wa := LowpolyKit.vec(wall["at"])
	var plane := ra.x + end * rs.x * 0.5
	var face := wa.x + end * ws.x * 0.5
	if (plane - face) * end < 0.0:
		return {"problem": "the end wall's face %.2f stands in front of the roof's edge %.2f" % [face, plane]}
	var wall_rect := Rect2(wa.x - ws.x * 0.5, wa.z - ws.z * 0.5, ws.x, ws.z)
	for o: Dictionary in definition.get("open", []):
		var os := LowpolyKit.vec(o["size"])
		var oa := LowpolyKit.vec(o["at"])
		if Rect2(oa.x - os.x * 0.5, oa.z - os.z * 0.5, os.x, os.z).grow(-0.01).intersects(wall_rect):  # touching is no overlap
			return {"problem": "an opening at %s is in that end wall" % oa}
	var half_w := float(cfg["width_m"]) * 0.5
	if wa.z - half_w < wall_rect.position.y or wa.z + half_w > wall_rect.end.y:
		return {"problem": "the ladder is wider than the end wall"}
	var top := Vector3(plane - end * float(cfg["top_step_m"]), roof_top, wa.z)
	var inset := Ladder.PAWN_RADIUS_M
	var roof_rect := Rect2(ra.x - rs.x * 0.5 + inset, ra.z - rs.z * 0.5 + inset, rs.x - inset * 2.0, rs.z - inset * 2.0)
	if not roof_rect.has_point(Vector2(top.x, top.z)):
		return {"problem": "the top-step point %s is not a pawn radius inside the roof" % top}
	var side := half_w + float(cfg["side_clear_m"])
	var x_out := plane + end * float(cfg["front_clear_m"])
	return {
		"foot": Vector3(plane, 0.0, wa.z),
		"top": top,
		"into": Vector3(-end, 0.0, 0.0),
		"height": roof_top,
		"clear": [minf(plane, x_out), maxf(plane, x_out), wa.z - side, wa.z + side],
	}


## The ground rectangle covered by the piece-frame box [x0, x1, z0, z1] of a piece at `origin` turned by `yaw`.
static func _local_rect(origin: Vector3, yaw: float, box: Array) -> Rect2:
	var turn := Basis(Vector3.UP, deg_to_rad(yaw))
	var rect := Rect2()
	var first := true
	for x: float in [float(box[0]), float(box[1])]:
		for z: float in [float(box[2]), float(box[3])]:
			var p := origin + turn * Vector3(x, 0.0, z)
			rect = Rect2(Vector2(p.x, p.z), Vector2.ZERO) if first else rect.expand(Vector2(p.x, p.z))
			first = false
	return rect


## The 90-degree-step yaw that turns a piece's local +X onto the ground direction `d` (axis-aligned).
static func _yaw_towards(d: Vector2) -> float:
	return fposmod(float(roundi(rad_to_deg(atan2(-d.y, d.x)) / 90.0) * 90), 360.0)


static func _spawns(cfg: Dictionary) -> Dictionary:
	var out := {}
	for i in int(cfg["count"]):
		var at := dir_of(float(cfg["first_bearing_deg"]) + 360.0 / int(cfg["count"]) * i) * float(cfg["radius_m"])
		out["spot_%d" % i] = [_r3(at.x), float(cfg["y"]), _r3(at.y)]
	return out


static func _landmark(id: String, name: String, kind: String, at: Vector2, radius: float, anchor: Vector2, terrain: MapTerrain) -> Dictionary:
	return {"id": id, "name": name, "kind": kind, "at": [_r3(at.x), _r3(at.y)], "radius_m": radius,
		"anchor": [_r3(anchor.x), _r3(terrain.height_at(anchor.x, anchor.y)), _r3(anchor.y)]}


static func _landmarks(gen: Dictionary, camp_centres: Array[Vector2], terrain: MapTerrain) -> Array:
	var radii: Dictionary = gen["landmark_radius_m"]
	var out: Array = []
	out.append(_landmark("arx", "Arx", "citadel", Vector2.ZERO, float(radii["arx"]), Vector2(0, 5), terrain))
	var outer: Dictionary = gen["outer_wall"]
	var r := float(outer["radius_m"])
	for i in (outer["gate_bearings_deg"] as Array).size():
		var b := float(outer["gate_bearings_deg"][i])
		var name := String(outer["gate_names"][i])
		out.append(_landmark(name.to_lower().replace(" ", "_"), name, "gate", dir_of(b) * r, float(radii["gate"]), dir_of(b) * (r - 12.0), terrain))
	var camps: Dictionary = gen["camps"]
	for c in camp_centres.size():
		var name := String(camps["names"][c])
		out.append(_landmark(name.to_lower().replace(" ", "_"), name, "legion camp", camp_centres[c], float(radii["camp"]), camp_centres[c] + Vector2(0, -4), terrain))
	var magnus: Dictionary = gen["aqueducts"][0]
	var line := right_of(float(magnus["bearing_deg"])) * float(magnus["offset_m"])
	var mid := line + dir_of(float(magnus["bearing_deg"])) * (float(magnus["inner_m"]) + 95.0)
	out.append(_landmark(String(magnus["id"]), String(magnus["name"]), "aqueduct", mid, float(radii["aqueduct"]), mid - right_of(float(magnus["bearing_deg"])) * 6.0, terrain))
	var sb := float(gen["specula_bearing_deg"])
	out.append(_landmark("specula", "Specula", "watchtower", dir_of(sb) * r, float(radii["tower"]), dir_of(sb) * (r - 12.0) + right_of(sb) * 5.0, terrain))
	return out


static func _reserved(gen: Dictionary) -> Array:
	var cfg: Dictionary = gen["reserved"]
	var out: Array = []
	var add := func(kind: String, at: Vector2) -> void:
		var n := 0
		for s: Dictionary in out:
			if s["kind"] == kind:
				n += 1
		out.append({"id": "%s_%02d" % [kind, n], "kind": kind, "at": [_r3(at.x), _r3(at.y)]})
	for b: Variant in cfg["jump_pad_wall"]["bearings_deg"]:
		add.call("jump_pad", dir_of(float(b)) * float(cfg["jump_pad_wall"]["radius_m"]))
	for aq: Dictionary in gen["aqueducts"]:
		add.call("jump_pad", right_of(float(aq["bearing_deg"])) * float(aq["offset_m"]) + dir_of(float(aq["bearing_deg"])) * float(cfg["jump_pad_aqueduct_m"]))
	for b: Variant in cfg["jump_pad_hill"]["bearings_deg"]:
		add.call("jump_pad", dir_of(float(b)) * float(cfg["jump_pad_hill"]["radius_m"]))
	for key: String in ["man_cannon_fields", "man_cannon_camps"]:
		for b: Variant in cfg[key]["bearings_deg"]:
			add.call("man_cannon", dir_of(float(b)) * float(cfg[key]["radius_m"]))
	for b: Variant in gen["outer_wall"]["gate_bearings_deg"]:
		for side: float in [-1.0, 1.0]:
			add.call("lily_trap", dir_of(float(b)) * float(cfg["lily_gate"]["radius_m"]) + right_of(float(b)) * side * float(cfg["lily_gate"]["lateral_m"]))
	for b: Variant in cfg["lily_fields"]["bearings_deg"]:
		add.call("lily_trap", dir_of(float(b)) * float(cfg["lily_fields"]["radius_m"]))
	return out


## One template per decor kind (the first alesia decor entry of that kind).
static func _decor_templates(cover_cfg: Dictionary) -> Dictionary:
	var out := {}
	for entry: Dictionary in cover_cfg["decor"]:
		if not out.has(entry["kind"]):
			out[entry["kind"]] = entry
	return out


## Uniform points on the ring r0 <= r < r1.
static func _annulus(r0: float, r1: float) -> Callable:
	return func(rng: RandomNumberGenerator) -> Vector2:
		var r := sqrt(rng.randf_range(r0 * r0, r1 * r1))
		var a := rng.randf() * TAU
		return Vector2(cos(a), sin(a)) * r


static func _rect_sampler(rect: Rect2) -> Callable:
	return func(rng: RandomNumberGenerator) -> Vector2:
		return Vector2(rng.randf_range(rect.position.x, rect.end.x), rng.randf_range(rect.position.y, rect.end.y))


## Ground rectangle of a box of `size` turned by a multiple of 90 degrees around its centre `at`.
static func _box_rect(at: Vector2, size: Vector3, yaw: float) -> Rect2:
	var quarter := posmod(roundi(yaw / 90.0), 2) == 1
	var w := size.z if quarter else size.x
	var d := size.x if quarter else size.z
	return Rect2(at.x - w * 0.5, at.y - d * 0.5, w, d)


## M2 L1b: the foot of a wall_stair's stair in the piece's frame (alesia_structures.json: the wedge at x -1, z 2.2,
## 6 m along x after its 90 degree turn, ridge 1 = its top towards +x by the landing box at x 3; so the foot is at
## x -4), half a metre past it.
const STAIR_FOOT := Vector2(-4.5, 2.2)
## M2 L1b: the foot of a watchtower's ramp in the piece's frame (the wedge at x 3.2, z -3.4, 7.2 m along z, ridge 1 =
## its top towards +z by the box at z 1.2; so the foot is at z -7.0), half a metre past it.
const TOWER_FOOT := Vector2(3.2, -7.5)
const EXTRA_AREAS := ["camps", "inner", "outer", "arx", "fields"]


## A point given in a ring piece's frame (x along the wall, z across), on the ground (x, z).
static func wall_point(p: Dictionary, local: Vector2) -> Vector2:
	var w := Basis(Vector3.UP, deg_to_rad(float(p["yaw"]))) * Vector3(local.x, 0.0, local.y)
	return Vector2(float(p["at"][0]) + w.x, float(p["at"][2]) + w.z)


## M2 L1b: the extra static cover of generator "extra_cover" (OQ-ALESIA-LAYOUT), in a fixed order after every earlier
## pass: each camp (inside its block, lane_gap_m to every footprint), the inner and the outer wall band (both faces;
## clear of that ring's gates by gate_clear_m, of every wall stair's foot by stair_clear_m and of every tower ramp's
## foot by tower_clear_m), the Arx top and the fields. Camp, band and Arx pieces continue "Cover_%03d" in `cover`,
## field pieces "Ring_%03d" in `ring_pieces`. The stair and ramp feet stay kept for every later pass; the gate
## circles only for the bands. Returns {counts: {area: placed}, ids: {area: [ids]}} over EXTRA_AREAS (all 0 without
## the block).
static func _extra_cover(state: Dictionary, cover: Array, ring_pieces: Array, camp_centres: Array[Vector2], inner: Dictionary, outer: Dictionary) -> Dictionary:
	var gen: Dictionary = state["gen"]
	var counts := {}
	var ids := {}
	for area: String in EXTRA_AREAS:
		counts[area] = 0
		ids[area] = []
	if not gen.has("extra_cover"):
		return {"counts": counts, "ids": ids}
	var extra: Dictionary = gen["extra_cover"]
	var keep: Array = state["keep"]
	# Camps: the lanes between every footprint stay lane_gap_m wide.
	var camp_cfg: Dictionary = extra["camps"]
	var half := float(gen["camps"]["half_size_m"])
	for c in camp_centres.size():
		var block := Rect2(camp_centres[c] - Vector2(half, half), Vector2(half, half) * 2.0)
		var first := cover.size()
		_cover(state, cover, "Cover_%03d", camp_cfg["cover_types"], int(camp_cfg["cover"]), _rect_sampler(block), "camp %d extra cover" % (c + 1), block, float(extra["lane_gap_m"]))
		_note_ids(ids["camps"], cover, first)
	# The walls: stair and ramp feet kept from here on, gates only while the bands are placed.
	for band_key: String in ["inner", "outer"]:
		var ring: Dictionary = inner if band_key == "inner" else outer
		var band: Dictionary = extra[band_key + "_wall"]
		for p: Dictionary in ring["pieces"]:
			if String(p["type"]) == "wall_stair":
				keep.append([wall_point(p, STAIR_FOOT), float(band["stair_clear_m"])])
			elif String(p["type"]) == "watchtower":
				keep.append([wall_point(p, TOWER_FOOT), float(band["tower_clear_m"])])
	for band_key: String in ["inner", "outer"]:
		var ring: Dictionary = inner if band_key == "inner" else outer
		var ring_cfg: Dictionary = gen[band_key + "_wall"]
		var band: Dictionary = extra[band_key + "_wall"]
		var mark := keep.size()
		for g: Dictionary in ring["gates"]:
			keep.append([g["at"] as Vector2, float(band["gate_clear_m"])])
		var total := int(band["cover"])
		var first := cover.size()
		for face: float in [-1.0, 1.0]:  # -1: the face towards the centre, +1: the face away from it
			var count := (total + 1) / 2 if face < 0.0 else total / 2
			_cover(state, cover, "Cover_%03d", band["cover_types"], count, _band_sampler(ring_cfg, band, face),
					"%s wall band %s cover" % [band_key, "inner face" if face < 0.0 else "outer face"])
		_note_ids(ids[band_key], cover, first)
		keep.resize(mark)
	var arx: Dictionary = extra["arx"]
	var arx_from := cover.size()
	_cover(state, cover, "Cover_%03d", arx["cover_types"], int(arx["cover"]), _annulus(0.0, float(arx["radius_m"])), "arx extra cover")
	_note_ids(ids["arx"], cover, arx_from)
	var fields: Dictionary = extra["fields"]
	var fields_from := ring_pieces.size()
	_cover(state, ring_pieces, "Ring_%03d", fields["cover_types"], int(fields["cover"]), _field_ring(state, float(gen["fields"]["from_m"]), float(gen["fields"]["to_m"])), "field extra cover")
	_note_ids(ids["fields"], ring_pieces, fields_from)
	for area: String in EXTRA_AREAS:
		counts[area] = (ids[area] as Array).size()
	return {"counts": counts, "ids": ids}


static func _note_ids(into: Array, out: Array, first: int) -> void:
	for i in range(first, out.size()):
		into.append(String(out[i]["id"]))


## M2 L1b: points beside one polygonal wall ring, on one face: a seeded side k, a place along it (clear of both
## corners by corner_margin_m) and a distance from_m..to_m from the side's centre line (the apothem), towards the
## centre (face -1) or away from it (face +1).
static func _band_sampler(ring_cfg: Dictionary, band: Dictionary, face: float) -> Callable:
	var sides := int(ring_cfg["sides"])
	var apothem := float(ring_cfg["radius_m"])
	var reach := maxf(apothem * tan(PI / sides) - float(band["corner_margin_m"]), 0.0)
	var d0 := float(band["from_m"])
	var d1 := float(band["to_m"])
	return func(rng: RandomNumberGenerator) -> Vector2:
		var b := deg_to_rad(float(rng.randi_range(0, sides - 1)) * 360.0 / float(sides))
		var u := rng.randf_range(-reach, reach)
		var d := rng.randf_range(d0, d1)
		# dir_of(bearing) * (apothem + face * d) + right_of(bearing) * u, written out
		return Vector2(sin(b), -cos(b)) * (apothem + face * d) + Vector2(cos(b), sin(b)) * u


const BREAKABLE_AREAS := ["camps", "inner_gates", "outer_gates", "arx", "fields"]


## M2 L1b: the breakable crates and barrels of generator "props" (OQ-PROPS-BREAK), in a fixed order after the extra
## cover: each camp (inside its block, extra_cover.lane_gap_m to every footprint), by the inner gates (spread over
## the gates, sides alternating), by the outer gates (the field side), on the Arx top and in the fields. Types
## round-robin over props.breakables.types in placement order; box sizes from props.types. Entries {id
## "Breakable_%03d", type, at [x, h/2, z], size}. Returns {entries, counts: {area: placed}} over BREAKABLE_AREAS
## (nothing without the block).
static func _breakables(state: Dictionary, camp_centres: Array[Vector2], inner: Dictionary, outer: Dictionary) -> Dictionary:
	var gen: Dictionary = state["gen"]
	var out: Array = []
	var counts := {}
	for area: String in BREAKABLE_AREAS:
		counts[area] = 0
	if not gen.has("props"):
		return {"entries": out, "counts": counts}
	var cfg: Dictionary = gen["props"]["breakables"]
	var sizes: Dictionary = gen["props"]["types"]
	var names: Array = cfg["types"]
	var half := float(gen["camps"]["half_size_m"])
	for c in camp_centres.size():
		var block := Rect2(camp_centres[c] - Vector2(half, half), Vector2(half, half) * 2.0)
		var first := out.size()
		_breakable(state, out, names, sizes, int(cfg["camps"]), _rect_sampler(block), "camp %d breakables" % (c + 1), block, float(gen["extra_cover"]["lane_gap_m"]))
		counts["camps"] = int(counts["camps"]) + out.size() - first
	var gates_cfg: Dictionary = gen["gates"]
	var reach := float(gates_cfg["reach_m"])
	var lateral := float(gates_cfg["lateral_m"])
	for ring_index in 2:
		var area := "inner_gates" if ring_index == 0 else "outer_gates"
		var ring_gates: Array = inner["gates"] if ring_index == 0 else outer["gates"]
		var count := int(cfg[area])
		for i in count:
			var g: Dictionary = ring_gates[(i * ring_gates.size()) / maxi(count, 1)]
			var side := (1.0 if i % 2 == 0 else -1.0) if ring_index == 0 else 1.0  # outer gates: the field side only
			var normal := g["normal"] as Vector2
			var along := g["tangent"] as Vector2
			var mid := (g["at"] as Vector2) + normal * side * reach
			var sampler := func(r: RandomNumberGenerator) -> Vector2:
				return mid + along * r.randf_range(-lateral, lateral) + normal * side * r.randf_range(-4.0, 4.0)
			var first := out.size()
			_breakable(state, out, names, sizes, 1, sampler, "gate %s breakable" % g["name"])
			counts[area] = int(counts[area]) + out.size() - first
	var arx_first := out.size()
	_breakable(state, out, names, sizes, int(cfg["arx"]), _annulus(0.0, float(cfg["arx_radius_m"])), "arx breakables")
	counts["arx"] = out.size() - arx_first
	var fields_first := out.size()
	_breakable(state, out, names, sizes, int(cfg["fields"]), _field_ring(state, float(gen["fields"]["from_m"]), float(gen["fields"]["to_m"])), "field breakables")
	counts["fields"] = out.size() - fields_first
	return {"entries": out, "counts": counts}


const CHEST_AREAS := ["camps", "arx", "fields"]


## M2 L1b: the loot chests of generator "props.chests" (OQ-PROPS-CHEST), in a fixed order after the breakables: each
## camp (inside its block, extra_cover.lane_gap_m to every footprint), the Arx top, the fields. A chest's footprint
## is its box (turned by a seeded multiple of 90 degrees) plus front_clear_m of ground in front of it (chest_rect),
## so its spill lands on open ground. Entries {id "Chest_%03d", at [x, h/2, z], size, yaw}. Returns {entries,
## counts: {area: placed}} over CHEST_AREAS (nothing without the block).
static func _chests(state: Dictionary, camp_centres: Array[Vector2]) -> Dictionary:
	var gen: Dictionary = state["gen"]
	var out: Array = []
	var counts := {}
	for area: String in CHEST_AREAS:
		counts[area] = 0
	if not gen.has("props") or not (gen["props"] as Dictionary).has("chests"):
		return {"entries": out, "counts": counts}
	var cfg: Dictionary = gen["props"]["chests"]
	var size_list: Array = cfg["size"]
	var clear := float(cfg["front_clear_m"])
	var half := float(gen["camps"]["half_size_m"])
	for c in camp_centres.size():
		var block := Rect2(camp_centres[c] - Vector2(half, half), Vector2(half, half) * 2.0)
		var first := out.size()
		_chest(state, out, size_list, clear, int(cfg["camps"]), _rect_sampler(block), "camp %d chests" % (c + 1), block, float(gen["extra_cover"]["lane_gap_m"]))
		counts["camps"] = int(counts["camps"]) + out.size() - first
	var arx_first := out.size()
	_chest(state, out, size_list, clear, int(cfg["arx"]), _annulus(0.0, float(cfg["arx_radius_m"])), "arx chests")
	counts["arx"] = out.size() - arx_first
	var fields_first := out.size()
	_chest(state, out, size_list, clear, int(cfg["fields"]), _field_ring(state, float(gen["fields"]["from_m"]), float(gen["fields"]["to_m"])), "field chests")
	counts["fields"] = out.size() - fields_first
	return {"entries": out, "counts": counts}


static func _chest(state: Dictionary, out: Array, size_list: Array, clear: float, count: int, sampler: Callable, label: String, inside := Rect2(), gap_m := -1.0) -> void:
	var size := LowpolyKit.vec(size_list)
	var placed := 0
	for i in count:
		var spot: Variant = _place(state, sampler, func(at: Vector2, yaw: float) -> Rect2: return chest_rect(at, size, yaw, clear), 90.0, inside, gap_m)
		if spot != null:
			out.append({"id": "Chest_%03d" % out.size(), "at": [spot[0].x, float(size_list[1]) * 0.5, spot[0].y], "size": size_list.duplicate(), "yaw": spot[1]})
			placed += 1
	if placed < count:
		_note(state, "shortfalls", "%s: %d of %d" % [label, placed, count])


## The ground a chest keeps: its box at `at` turned by `yaw` (a multiple of 90 degrees) grown by `clear` metres on
## its front side, the side it opens towards (local -z turned by the yaw: 0 -> -z, 90 -> -x, 180 -> +z, 270 -> +x).
static func chest_rect(at: Vector2, size: Vector3, yaw: float, clear: float) -> Rect2:
	var r := _box_rect(at, size, yaw)
	match posmod(roundi(yaw / 90.0), 4):
		0:
			r.position.y -= clear
			r.size.y += clear
		1:
			r.position.x -= clear
			r.size.x += clear
		2:
			r.size.y += clear
		3:
			r.size.x += clear
	return r


## Breakable entries (unturned boxes, like cover pieces), the type by the entry's index round-robin.
static func _breakable(state: Dictionary, out: Array, names: Array, sizes: Dictionary, count: int, sampler: Callable, label: String, inside := Rect2(), gap_m := -1.0) -> void:
	var placed := 0
	for i in count:
		var type: String = names[out.size() % names.size()]
		var size_list: Array = sizes[type]["size"]
		var size := LowpolyKit.vec(size_list)
		var spot: Variant = _place(state, sampler, func(at: Vector2, _yaw: float) -> Rect2: return _box_rect(at, size, 0.0), 0.0, inside, gap_m)
		if spot != null:
			out.append({"id": "Breakable_%03d" % out.size(), "type": type, "at": [spot[0].x, float(size_list[1]) * 0.5, spot[0].y], "size": size_list.duplicate()})
			placed += 1
	if placed < count:
		_note(state, "shortfalls", "%s: %d of %d" % [label, placed, count])


## Cover pieces ({id, type, at}; no yaw), types round-robin. `gap_m` >= 0 replaces placement.minimum_gap_m (M2 L1b:
## the camps' extra pieces keep extra_cover.lane_gap_m to every footprint).
static func _cover(state: Dictionary, out: Array, id_format: String, names: Array, count: int, sampler: Callable, label: String, inside := Rect2(), gap_m := -1.0) -> void:
	var types: Dictionary = state["cover_types"]
	var placed := 0
	for i in count:
		var type: String = names[i % names.size()]
		var size := LowpolyKit.vec(types[type]["size"])
		var slack := float((state.get("contact", {}) as Dictionary).get("max_sink_m", 0.0))  # M2 L2a: cover may sink (0 without the key)
		var spot: Variant = _place(state, sampler, func(at: Vector2, _yaw: float) -> Rect2: return _box_rect(at, size, 0.0), 0.0, inside, gap_m, slack)
		if spot != null:
			out.append({"id": id_format % out.size(), "type": type, "at": [spot[0].x, float(types[type]["size"][1]) * 0.5 - float(spot[2]), spot[0].y]})
			placed += 1
	if placed < count:
		_note(state, "shortfalls", "%s: %d of %d" % [label, placed, count])


static func _stakes(state: Dictionary, out: Array, id_format: String, count: int, sampler: Callable, kit_types: Dictionary, label: String, inside := Rect2()) -> void:
	var definition: Dictionary = kit_types["stake_row"]
	var placed := 0
	for i in count:
		var spot: Variant = _place(state, sampler, func(at: Vector2, yaw: float) -> Rect2: return WorldKit.footprint(definition, Vector3(at.x, 0.0, at.y), yaw), 90.0, inside)
		if spot != null:
			out.append({"id": id_format % placed, "type": "stake_row", "at": [spot[0].x, 0.0, spot[0].y], "yaw": spot[1]})
			placed += 1
	if placed < count:
		_note(state, "shortfalls", "%s: %d of %d" % [label, placed, count])


static func _decor(state: Dictionary, out: Array, template: Dictionary, count: int, sampler: Callable, label: String) -> void:
	var size := LowpolyKit.vec(template["size"])
	var placed := 0
	var buried := maxf(0.0, size.y * 0.5 - float(template["at"][1]))  # M2 L2a: a decor piece set into the ground may stand on a slope that deep
	for i in count:
		var spot: Variant = _place(state, sampler, func(at: Vector2, yaw: float) -> Rect2: return _box_rect(at, size, yaw), 90.0, Rect2(), -1.0, buried)
		if spot != null:
			out.append({"id": "Decor_%03d" % out.size(), "kind": template["kind"], "size": (template["size"] as Array).duplicate(), "at": [spot[0].x, float(template["at"][1]), spot[0].y], "yaw": spot[1]})
			placed += 1
	if placed < count:
		_note(state, "shortfalls", "%s: %d of %d" % [label, placed, count])


## Rejection sampling (gen_test_map.gd's rules on a round map): up to max_attempts snapped candidates from
## `sampler`; the footprint must lie inside the play circle less the edge margin (and inside `inside` when it has
## area), keep its keep-out circles, keep the minimum gap from every footprint so far and stand on fit ground
## (gen_test_map.ground_fits). Returns [Vector2 at, float yaw] and records the footprint, or null. `gap_m` >= 0
## replaces the minimum gap (M2 L1b: the camps' lanes); the default keeps every earlier pass exactly as it was.
## M2 L2a: with generator.ground_contact (state "contact"), the spot must also pass _contact_sink with `slack_m` (the
## returned triple's third value is how far the piece is sunk; always 0.0 without the key, so the 1 km map is as before).
static func _place(state: Dictionary, sampler: Callable, footprint: Callable, yaw_step: float, inside: Rect2, gap_m := -1.0, slack_m := 0.0) -> Variant:
	var rng: RandomNumberGenerator = state["rng"]
	var place: Dictionary = state["place"]
	var snap := float(place["snap_m"])
	var gap := gap_m if gap_m >= 0.0 else float(place["minimum_gap_m"])
	var limit := float(state["play_r"]) - float(place["edge_margin_m"])
	var placed: Array[Rect2] = state["placed"]
	var steps := int(round(360.0 / yaw_step)) if yaw_step > 0.0 else 1
	for attempt in int(place["max_attempts"]):
		var raw: Vector2 = sampler.call(rng)
		var at := Vector2(snappedf(raw.x, snap), snappedf(raw.y, snap))
		var yaw := float(rng.randi_range(0, steps - 1)) * yaw_step if yaw_step > 0.0 else 0.0
		var rect: Rect2 = footprint.call(at, yaw)
		if inside.has_area() and not inside.encloses(rect):
			continue
		var out_of_circle := false
		for corner: Vector2 in [rect.position, Vector2(rect.end.x, rect.position.y), Vector2(rect.position.x, rect.end.y), rect.end]:
			out_of_circle = out_of_circle or corner.length() > limit
		if out_of_circle:
			continue
		var kept := true
		for keep: Array in state["keep"]:
			if WorldRing.rect_distance(keep[0], rect) < float(keep[1]):
				kept = false
				break
		if not kept:
			continue
		var free := true
		for other in placed:
			if WorldRing.rect_gap(rect, other) < gap:
				free = false
				break
		if not free:
			continue
		if not _GenTest.ground_fits(state["terrain"], at, rect):
			state["ground_rejects"] = int(state["ground_rejects"]) + 1
			continue
		var sink := 0.0
		if not (state.get("contact", {}) as Dictionary).is_empty():
			sink = _contact_sink(state, at, rect, slack_m)
			if sink < 0.0:
				state["ground_rejects"] = int(state["ground_rejects"]) + 1
				state["contact_rejects"] = int(state.get("contact_rejects", 0)) + 1
				continue
		placed.append(rect)
		return [at, yaw, sink]
	return null


## M2 L2a (generator.ground_contact, OQ-ALESIA-500): how far a piece at `at` with ground rect `rect` must be sunk so
## its bottom (the ground under its origin, where the builder stands it) is at most max_float_m above the lowest
## ground under the rect grown by margin_m (sampled at corners, edge middles and centre): 0.0 when it already is,
## -1.0 when it would have to sink more than `slack_m` (the piece does not fit there).
static func _contact_sink(state: Dictionary, at: Vector2, rect: Rect2, slack_m: float) -> float:
	var gc: Dictionary = state["contact"]
	var terrain: MapTerrain = state["terrain"]
	var r := rect.grow(float(gc["margin_m"]))
	var origin := terrain.height_at(at.x, at.y)
	var low := origin
	for u: float in [0.0, 0.5, 1.0]:
		for v: float in [0.0, 0.5, 1.0]:
			low = minf(low, terrain.height_at(lerpf(r.position.x, r.end.x, u), lerpf(r.position.y, r.end.y, v)))
	var over := origin - low - float(gc["max_float_m"])
	if over <= 0.0:
		return 0.0
	if over > slack_m:
		return -1.0
	return ceilf(over * 100.0) / 100.0


# --- M2 L2a: the 500 m map's laid-out areas (OQ-ALESIA-500). Every pass reads its own generator key and does nothing
# without it, so the 1 km map (none of these keys) keeps every piece and every random draw. ---

## M2 L2a: the fields' sampler: _annulus itself, unless state has "field_avoid" rects (set by _layout_500: the camp
## and farmstead blocks, which lie inside the 500 m map's field ring), when up to 32 draws are taken until one lies
## outside them.
static func _field_ring(state: Dictionary, r0: float, r1: float) -> Callable:
	var plain := _annulus(r0, r1)
	var avoid: Array = state.get("field_avoid", [])
	if avoid.is_empty():
		return plain
	return func(rng: RandomNumberGenerator) -> Vector2:
		var p: Vector2 = plain.call(rng)
		for i in 32:
			var inside := false
			for r: Rect2 in avoid:
				if r.has_point(p):
					inside = true
					break
			if not inside:
				return p
			p = plain.call(rng)
		return p


## M2 L2a (generator.doorway_apron_m): the ground in front of each listed doorway (doors.door.openings) of a barracks
## piece: the opening's width, apron_m deep from the wall's outer face, as ground rects. Kept free of every other
## footprint (a template drops a barracks whose apron meets one, or a later template piece standing on one) and
## recorded in state.placed, so the random passes keep placement.minimum_gap_m from it: nothing stands within apron_m
## in front of a doorway.
static func doorway_aprons(piece: Dictionary, kit_types: Dictionary, openings: Array, apron_m: float) -> Array[Rect2]:
	var out: Array[Rect2] = []
	var opens: Array = (kit_types[piece["type"]] as Dictionary).get("open", [])
	var origin := LowpolyKit.vec(piece["at"])
	for index: Variant in openings:
		var o: Dictionary = opens[int(index)]
		var at := LowpolyKit.vec(o["at"])
		var size := LowpolyKit.vec(o["size"])
		var face := absf(at.z) + size.z * 0.5
		var s := signf(at.z)
		var z0 := s * face
		var z1 := s * (face + apron_m)
		out.append(_local_rect(origin, float(piece["yaw"]), [at.x - size.x * 0.5, at.x + size.x * 0.5, minf(z0, z1), maxf(z0, z1)]))
	return out


## M2 L2a: a point of a block's frame turned by `quarter` x 90 degrees, Godot's yaw (x' = x cos + z sin, z' = -x sin
## + z cos): quarter 1 takes local -z (a template's front) to -x.
static func _quarter(p: Vector2, quarter: int) -> Vector2:
	match posmod(quarter, 4):
		1:
			return Vector2(p.y, -p.x)
		2:
			return Vector2(-p.x, -p.y)
		3:
			return Vector2(-p.y, p.x)
	return p


## M2 L2a: the quarter turn that points a template's front (local -z) most nearly at the map centre from `centre`.
static func _quarter_facing_centre(centre: Vector2) -> int:
	var best := 0
	var best_dot := -INF
	var to_centre := -centre.normalized()
	for q in 4:
		var d := _quarter(Vector2(0.0, -1.0), q).dot(to_centre)
		if d > best_dot + 0.000001:
			best_dot = d
			best = q
	return best


## M2 L2a: template `tpl` laid out in a block centred on `centre`, turned by `quarter`: [{structure, type, at
## (Vector2), yaw, rect, aprons}] in template order. A template piece is {type, at [x, z] in the block's frame (front
## = -z), yaw (structures), every (optional: only in blocks whose index is a multiple of it)}. Kit types are structures
## and turn with the block; cover types are unturned boxes (the cover file has no yaw), so in a block turned by an odd
## quarter a cover type listed in ctx.quarter_types becomes that type (a long box along z for one along x).
static func _template_layout(tpl: Dictionary, centre: Vector2, quarter: int, index: int, ctx: Dictionary) -> Array:
	var kit_types: Dictionary = ctx["kit"]
	var cover_types: Dictionary = ctx["cover"]
	var quarter_types: Dictionary = tpl.get("quarter_types", ctx["quarter_types"])  # a template may name its own swaps ({} = none)
	var out: Array = []
	for entry: Dictionary in tpl["pieces"]:
		if entry.has("every") and index % int(entry["every"]) != 0:
			continue
		var type := String(entry["type"])
		var p := centre + _quarter(Vector2(float(entry["at"][0]), float(entry["at"][1])), quarter)
		var at := Vector2(_r3(p.x), _r3(p.y))
		if kit_types.has(type):
			var yaw := fposmod(float(entry.get("yaw", 0.0)) + 90.0 * quarter, 360.0)
			var aprons: Array[Rect2] = []
			var openings: Array = ctx["openings"] if type == String(ctx["apron_type"]) else kit_types[type].get("doorway_indices", [])
			if not openings.is_empty() and float(ctx["apron_m"]) > 0.0:
				aprons = doorway_aprons({"type": type, "at": [at.x, 0.0, at.y], "yaw": yaw}, kit_types, openings, float(ctx["apron_m"]))
			out.append({"structure": true, "type": type, "at": at, "yaw": yaw, "rect": WorldKit.footprint(kit_types[type], Vector3(at.x, 0.0, at.y), yaw), "aprons": aprons})
		else:
			if posmod(quarter, 2) == 1 and quarter_types.has(type):
				type = String(quarter_types[type])
			var size := LowpolyKit.vec(cover_types[type]["size"])
			out.append({"structure": false, "type": type, "at": at, "yaw": 0.0, "rect": _box_rect(at, size, 0.0), "aprons": [] as Array[Rect2]})
	return out


## M2 L2a: why a laid-out piece (ground rect `rect`, origin `at`) cannot stand where it is, or "" when it can: the
## _place rules without the random draw (inside `inside` when it has area and inside the play circle less the edge
## margin, clear of every keep circle, `gap` from every rect of `placed`, on fit ground).
static func _misfit(state: Dictionary, placed: Array[Rect2], at: Vector2, rect: Rect2, inside: Rect2, gap: float) -> String:
	if inside.has_area() and not inside.encloses(rect):
		return "leaves its block"
	var limit := float(state["play_r"]) - float(state["place"]["edge_margin_m"])
	for corner: Vector2 in [rect.position, Vector2(rect.end.x, rect.position.y), Vector2(rect.position.x, rect.end.y), rect.end]:
		if corner.length() > limit:
			return "leaves the play circle"
	for keep: Array in state["keep"]:
		if WorldRing.rect_distance(keep[0], rect) < float(keep[1]):
			return "on the kept spot %s" % str(keep[0])
	for other in placed:
		if WorldRing.rect_gap(rect, other) < gap:
			return "%.2f m from the footprint %s" % [WorldRing.rect_gap(rect, other), str(other)]
	if not _GenTest.ground_fits(state["terrain"], at, rect):
		return "unfit ground"
	if not (state.get("contact", {}) as Dictionary).is_empty() and _contact_sink(state, at, rect, 0.0) < 0.0:
		return "would float on the slope (ground_contact)"
	return ""


## M2 L2a: places a layout's pieces in order; a piece that misfits (placement.minimum_gap_m) or whose doorway apron
## meets a footprint is DROPPED and noted, never moved. With `commit` false nothing is recorded (a trial). Returns
## {kept: [layout entries], dropped: [String]}.
## `own_gap` >= 0 (the camp pickets, the vineyard plots): the layout's own pieces keep only that gap from each other
## (a sandbag nest's three pieces, a plot's stake rows end to end), still placement.minimum_gap_m from everything else.
static func _fit_layout(state: Dictionary, layout: Array, inside: Rect2, commit: bool, own_gap := -1.0) -> Dictionary:
	var gap := float(state["place"]["minimum_gap_m"])
	var placed: Array[Rect2] = state["placed"]
	var reach := inside.grow(6.0)
	var near: Array[Rect2] = []
	for r in placed:
		if not inside.has_area() or reach.intersects(r, true):
			near.append(r)
	var own: Array[Rect2] = []
	var kept: Array = []
	var dropped: Array = []
	var aprons: Array[Rect2] = []  # this layout's doorway aprons: no piece of it may stand on one (no gap asked)
	for e: Dictionary in layout:
		var why := _misfit(state, near, e["at"], e["rect"], inside, gap)
		if why == "":
			for o in own:
				if WorldRing.rect_gap(e["rect"], o) < own_gap:
					why = "%.2f m from its own piece %s" % [WorldRing.rect_gap(e["rect"], o), str(o)]
					break
		if why == "":
			for a: Rect2 in aprons:
				if a.intersects(e["rect"]):
					why = "on the doorway apron %s" % str(a)
					break
		if why == "":
			for a: Rect2 in e["aprons"]:
				for other in near:
					if a.intersects(other):
						why = "a doorway apron meets the footprint %s" % str(other)
						break
				if why != "":
					break
		if why != "":
			dropped.append("%s at (%.1f, %.1f): %s" % [e["type"], (e["at"] as Vector2).x, (e["at"] as Vector2).y, why])
			continue
		kept.append(e)
		if own_gap >= 0.0:
			own.append(e["rect"])
		else:
			near.append(e["rect"])
		aprons.append_array(e["aprons"])
		if commit:
			placed.append(e["rect"])
			placed.append_array(e["aprons"])
	return {"kept": kept, "dropped": dropped}


## M2 L2a: the kept pieces as file entries: structures "<prefix>_<label>_<n>" (label from `labels` by type, else the
## type in CamelCase; n counts per label) into `structures`, cover pieces `id_format` % size into `cover_list`.
static func _emit(kept: Array, prefix: String, labels: Dictionary, structures: Array, cover_list: Array, id_format: String, cover_types: Dictionary) -> void:
	var n := {}
	for e: Dictionary in kept:
		var at: Vector2 = e["at"]
		var type := String(e["type"])
		if bool(e["structure"]):
			var label := String(labels.get(type, type.capitalize().replace(" ", "")))
			var k := int(n.get(label, 0))
			n[label] = k + 1
			structures.append({"id": "%s_%s_%d" % [prefix, label, k], "type": type, "at": [at.x, 0.0, at.y], "yaw": float(e["yaw"])})
		else:
			cover_list.append({"id": id_format % cover_list.size(), "type": type, "at": [at.x, float(cover_types[type]["size"][1]) * 0.5, at.y]})


## M2 L2a: the 500 m map's laid-out areas, after the keep circles and before every random pass: the Arx ring's keeps
## (its gates, stair and ramp feet), the doorway aprons of the camp barracks (doorway_apron_m), the camps' fixed
## pieces (camps.extras), the town street grid (town), the farmsteads (farmsteads), the camp and farmstead blocks kept
## out of the field passes, the field wall runs (field_walls) and the outside strip's stake rows (outside). Returns {}
## when the map has none of these keys; else {cells, farms, dropped, ...} for the report and the later passes.
static func _layout_500(state: Dictionary, structures: Array, cover: Array, ring_pieces: Array, camp_centres: Array[Vector2], arx_ring: Dictionary, landmarks: Array, kit_types: Dictionary) -> Dictionary:
	var gen: Dictionary = state["gen"]
	var keys := ["doorway_apron_m", "town", "farmsteads", "field_walls", "outside"]
	var any := not arx_ring.is_empty() or (gen["camps"] as Dictionary).has("extras")
	for key: String in keys:
		any = any or gen.has(key)
	if not any:
		return {}
	var out := {"cells": [], "farms": [], "dropped": [], "arx_pieces": 0, "camp_extras": 0, "field_walls": 0,
		"field_wall_pieces": 0, "outside_stakes": 0, "districts": 0, "town_cover": 0, "farm_cover": 0,
		"posts": [], "plots": [], "fills": [], "small_farms": 0}
	var keep: Array = state["keep"]
	var placed: Array[Rect2] = state["placed"]
	var problems: PackedStringArray = state["problems"]
	# a. The Arx ring: its gates kept on both sides (as the inner gates), its stair and tower-ramp feet kept.
	if not arx_ring.is_empty():
		var arx_cfg: Dictionary = gen["arx_wall"]
		out["arx_pieces"] = (arx_ring["pieces"] as Array).size()
		for g: Dictionary in arx_ring["gates"]:
			for side: float in [-1.0, 1.0]:
				keep.append([(g["at"] as Vector2) + (g["normal"] as Vector2) * side * 4.0, float(gen["gates"]["clear_m"])])
		for p: Dictionary in arx_ring["pieces"]:
			if String(p["type"]) == "wall_stair":
				keep.append([wall_point(p, STAIR_FOOT), float(arx_cfg.get("stair_clear_m", 4.0))])
			elif String(p["type"]) == "watchtower":
				keep.append([wall_point(p, TOWER_FOOT), float(arx_cfg.get("tower_clear_m", 6.0))])
	# b. Doorway aprons of the barracks placed so far (the camps).
	var apron := float(gen.get("doorway_apron_m", 0.0))
	var openings: Array = gen["doors"]["door"]["openings"] if gen.has("doors") else [0, 1]
	var apron_type := String(gen["doors"]["door"]["type"]) if gen.has("doors") else "barracks"
	if apron > 0.0:
		for piece: Dictionary in structures.duplicate():
			if String(piece["type"]) != apron_type:
				continue
			var own := WorldKit.footprint(kit_types[apron_type], LowpolyKit.vec(piece["at"]), float(piece["yaw"]))
			for a: Rect2 in doorway_aprons(piece, kit_types, openings, apron):
				for other in placed:
					if other != own and a.intersects(other):
						problems.append("%s: a doorway apron meets the footprint %s" % [piece["id"], str(other)])
						break
				placed.append(a)
	var town: Dictionary = gen.get("town", {})
	var ctx := {"kit": kit_types, "cover": state["cover_types"], "apron_m": apron, "apron_type": apron_type, "openings": openings,
		"quarter_types": town.get("quarter_types", {})}
	var labels: Dictionary = town.get("labels", {})
	var camps: Dictionary = gen["camps"]
	var half := float(camps["half_size_m"])
	var avoid: Array[Rect2] = []
	for c in camp_centres.size():
		avoid.append(Rect2(camp_centres[c] - Vector2(half, half), Vector2(half, half) * 2.0))
	# c. Each camp's fixed pieces (supply corner), unturned, inside its block.
	if camps.has("extras"):
		for c in camp_centres.size():
			var fit := _fit_layout(state, _template_layout({"pieces": camps["extras"]}, camp_centres[c], 0, c, ctx), avoid[c], true)
			for line: String in fit["dropped"]:
				(out["dropped"] as Array).append("Castra%d extras: %s" % [c + 1, line])
			var before := cover.size()
			_emit(fit["kept"], "Castra%d" % (c + 1), labels, structures, cover, "Cover_%03d", state["cover_types"])
			out["camp_extras"] = int(out["camp_extras"]) + (fit["kept"] as Array).size()
			if cover.size() - before != (fit["kept"] as Array).size():
				problems.append("Castra%d extras: only cover types may be listed" % (c + 1))
	# d. The town street grid.
	if not town.is_empty():
		_town(state, structures, cover, landmarks, ctx, avoid, out)
	# e. The farmsteads.
	if gen.has("farmsteads"):
		_farmsteads(state, structures, cover, ctx, out)
	# e2. M2 L2a density pass (each only with its key): the camps' picket posts, the small farmsteads, the vineyard
	# plots and the town's half blocks.
	var blocks: Array[Rect2] = []
	if gen.has("statio"):
		_statio(state, structures, cover, ctx, camp_centres, out, blocks)
	if gen.has("farmsteads") and (gen["farmsteads"] as Dictionary).has("small"):
		_farmsteads_small(state, structures, cover, ctx, out)
	if gen.has("vineae"):
		_vineae(state, structures, out, blocks)
	if not town.is_empty() and town.has("fill"):
		_town_fill(state, structures, cover, ctx, avoid, out)
	# f. The field passes keep out of the camp and farmstead blocks from here on.
	for farm: Dictionary in out["farms"]:
		avoid.append(farm["rect"])
	avoid.append_array(blocks)
	state["field_avoid"] = avoid
	# g. The field wall runs.
	if gen.has("field_walls"):
		_field_walls(state, ring_pieces, out)
	# h. The outside strip's stake rows.
	if gen.has("outside"):
		var strip: Dictionary = gen["outside"]
		var first := structures.size()
		_stakes(state, structures, "Outside_Stakes_%d", int(strip["stake_rows"]), _annulus(float(strip["from_m"]), float(strip["to_m"])), kit_types, "outside stakes")
		out["outside_stakes"] = structures.size() - first
	return out


## M2 L2a: the town (generator.town): cells on a square grid (centres at cell_offset_m + pitch_m k on both axes, a
## block_m square each, streets between), built when the centre lies band_from_m..band_to_m from the map centre, the
## block keeps inner_clear_m from the centre (the inner wall) and camp_clear_m from every camp block. Cells are taken
## in bearing order; town.cells assigns a template to the free cell nearest each listed bearing, the rest get
## default_template. A template with face "centre" turns its front to the map centre; any other turns by the cell's
## index (quarter index % 4) unless another quarter drops fewer pieces (tried in order index, index + 1, ...).
## Template pieces are fixed (dropped, never moved, when they misfit); then each template with a landmark {id, name}
## names its first cell (kind "district", anchor = the template's anchor turned with the cell), and every cell gets
## its template's "cover" random pieces (town.cover_types, turned by the cell index) inside the block.
static func _town(state: Dictionary, structures: Array, cover: Array, landmarks: Array, ctx: Dictionary, camp_blocks: Array[Rect2], out: Dictionary) -> void:
	var gen: Dictionary = state["gen"]
	var town: Dictionary = gen["town"]
	var pitch := float(town["pitch_m"])
	var block := float(town["block_m"])
	var offset := float(town["cell_offset_m"])
	var from := float(town["band_from_m"])
	var to := float(town["band_to_m"])
	var reach := ceili(to / pitch) + 1
	var cells: Array = []
	for j in range(-reach, reach + 1):
		for i in range(-reach, reach + 1):
			var c := Vector2(offset + pitch * i, offset + pitch * j)
			if c.length() < from or c.length() > to:
				continue
			var rect := Rect2(c - Vector2(block, block) * 0.5, Vector2(block, block))
			if WorldRing.rect_distance(Vector2.ZERO, rect) < float(town["inner_clear_m"]):
				continue
			var clear := true
			for camp in camp_blocks:
				clear = clear and WorldRing.rect_gap(rect, camp) >= float(town["camp_clear_m"])
			if clear:
				cells.append({"centre": c, "rect": rect, "bearing": fposmod(rad_to_deg(atan2(c.x, -c.y)), 360.0)})
	cells.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return float(a["bearing"]) < float(b["bearing"]))
	var templates: Dictionary = town["templates"]
	for k in cells.size():
		cells[k]["template"] = String(town["default_template"])
	var taken := {}
	for a: Dictionary in town["cells"]:
		var best := -1
		var best_d := INF
		for k in cells.size():
			if taken.has(k):
				continue
			var d := absf(angle_difference(deg_to_rad(float(a["bearing_deg"])), deg_to_rad(float(cells[k]["bearing"]))))
			if d < best_d - 0.000001:
				best_d = d
				best = k
		if best >= 0:
			taken[best] = true
			cells[best]["template"] = String(a["template"])
	var counts := {}
	var style_rules: Dictionary = (gen.get("cx2_world", {}) as Dictionary).get("town", {})
	for k in cells.size():
		var cell: Dictionary = cells[k]
		var tpl := _cx2_town_template(templates[cell["template"]], style_rules.get(cell["template"], {}), k)
		var centre: Vector2 = cell["centre"]
		var quarter := _quarter_facing_centre(centre) if String(tpl.get("face", "")) == "centre" else k % 4
		if String(tpl.get("face", "")) != "centre":
			var fewest := INF
			for t in 4:
				var q := (k + t) % 4
				var trial := _fit_layout(state, _template_layout(tpl, centre, q, k, ctx), cell["rect"], false)
				if (trial["dropped"] as Array).size() < fewest:
					fewest = (trial["dropped"] as Array).size()
					quarter = q
		var fit := _fit_layout(state, _template_layout(tpl, centre, quarter, k, ctx), cell["rect"], true)
		var prefix := "Oppidum%02d" % k
		for line: String in fit["dropped"]:
			(out["dropped"] as Array).append("%s %s q%d: %s" % [prefix, cell["template"], quarter, line])
		_emit(fit["kept"], prefix, ctx.get("labels", town.get("labels", {})), structures, cover, "Cover_%03d", state["cover_types"])
		cell["quarter"] = quarter
		cell["prefix"] = prefix
		cell["kept"] = (fit["kept"] as Array).size()
		cell["dropped"] = (fit["dropped"] as Array).size()
		cell["kept_rects"] = (fit["kept"] as Array).map(func(e: Dictionary) -> Rect2: return e["rect"])
		counts[cell["template"]] = int(counts.get(cell["template"], 0)) + 1
	# District landmarks: the first cell of each template that names one.
	var place: Dictionary = gen["placement"]
	var named := {}
	for cell: Dictionary in cells:
		var tpl: Dictionary = templates[cell["template"]]
		if not tpl.has("landmark") or named.has(cell["template"]):
			continue
		named[cell["template"]] = true
		var lm: Dictionary = tpl["landmark"]
		var local: Array = tpl.get("anchor", [0.0, 0.0])
		var anchor: Vector2 = (cell["centre"] as Vector2) + _quarter(Vector2(float(local[0]), float(local[1])), int(cell["quarter"]))
		landmarks.append(_landmark(String(lm["id"]), String(lm["name"]), "district", cell["centre"], float(gen["landmark_radius_m"]["district"]), anchor, state["terrain"]))
		cell["landmark"] = String(lm["id"])
		for r: Rect2 in cell["kept_rects"]:
			if WorldRing.rect_distance(anchor, r) < float(place["anchor_clear_m"]):
				_note(state, "problems", "district %s: its anchor %s is %.2f m from a piece (anchor_clear_m %s)" % [lm["id"], str(anchor), WorldRing.rect_distance(anchor, r), str(place["anchor_clear_m"])])
		(state["keep"] as Array).append([anchor, float(place["anchor_clear_m"])])
		out["districts"] = int(out["districts"]) + 1
	# Random small cover inside every cell.
	var types: Array = town["cover_types"]
	var lane := _town_lane(gen)
	var first := cover.size()
	for k in cells.size():
		var cell: Dictionary = cells[k]
		var shift := k % types.size()
		var turned: Array = types.slice(shift) + types.slice(0, shift)
		_cover(state, cover, "Cover_%03d", turned, int(templates[cell["template"]].get("cover", 0)), _rect_sampler(cell["rect"]), "town %s cover" % cell["prefix"], cell["rect"], lane)
	out["town_cover"] = cover.size() - first
	out["cells"] = cells
	out["town_counts"] = counts


## Replace selected pieces on the 500 m templates before placing them, so the checks see
## the real footprints and door aprons. Leave some original low roofs between the taller blocks.
static func _cx2_town_template(tpl: Dictionary, rules: Dictionary, cell: int) -> Dictionary:
	if rules.is_empty():
		return tpl
	var result := tpl.duplicate(true)
	var seen := {}
	for piece: Dictionary in result["pieces"]:
		var base := String(piece["type"])
		var entries: Array = rules.get(base, [])
		var index := int(seen.get(base, 0))
		seen[base] = index + 1
		if index >= entries.size() or String(entries[index]).is_empty():
			continue
		var replacement := String(entries[index])
		if replacement == "insula_triple" and cell % 3 != 0:
			continue
		piece["type"] = replacement
	return result


## District dress after the original deterministic draws, clear of existing footprints,
## doors and kept spots. Tower and span variants carry the original collision shapes.
static func _cx2_landmarks_and_dressing(state: Dictionary, structures: Array, kit: Dictionary, report: Dictionary) -> void:
	var cfg: Dictionary = state["gen"]["cx2_world"]
	var crowns: Array[Dictionary] = []
	for piece: Dictionary in structures:
		var base := String(piece["type"])
		var id := String(piece["id"])
		if id == "Arx_Eagle":
			piece["type"] = "arx_signal_eagle"
		elif base == "watchtower":
			var turn := Basis(Vector3.UP, deg_to_rad(float(piece["yaw"])))
			var mast := LowpolyKit.vec(piece["at"]) + turn * Vector3(-2.0, 0.0, -2.0)
			crowns.append({"id": "CX2_Beacon_" + id, "type": "specula_beacon", "at": [mast.x, 0.0, mast.z], "yaw": 0.0})
		elif base == "aqueduct_span":
			piece["type"] = "aqua_keystone"
	var ctx := {"kit": kit, "cover": state["cover_types"], "quarter_types": {},
		"apron_type": "", "apron_m": 0.0, "openings": []}
	var counts := {}
	for group: Dictionary in cfg["dressing"]:
		var type := String(group["type"])
		for i in (group["sites"] as Array).size():
			var site: Array = group["sites"][i]
			var bearing := float(site[0])
			var radius := float(site[1])
			var yaw := float(site[2])
			var make := func(at: Vector2) -> Array:
				return _template_layout({"pieces": [{"type": type, "at": [0.0, 0.0], "yaw": yaw}]}, at, 0, 0, ctx)
			var found := _search_spot(state, bearing, radius, group["search"], Vector2.ZERO, make, -1.0)
			if int(found["dropped"]) != 0:
				continue
			var fit := _fit_layout(state, found["layout"], Rect2(), true)
			_emit(fit["kept"], "CX2_%s_%02d" % [type, i], {}, structures, [], "", state["cover_types"])
			counts[type] = int(counts.get(type, 0)) + 1
	structures.append_array(crowns)
	report["cx2_dressing"] = counts


## M2 L2a: the farmsteads (generator.farmsteads): one block of half_size_m per name at bearings first_bearing_deg +
## 360 / count k, radius_m out, laid out from town.templates[template] with its front to the map centre; pieces
## "Villa<k>_<label>_<n>" (1-based k). Then `cover` random pieces (cover_types) inside each block.
static func _farmsteads(state: Dictionary, structures: Array, cover: Array, ctx: Dictionary, out: Dictionary) -> void:
	var gen: Dictionary = state["gen"]
	var cfg: Dictionary = gen["farmsteads"]
	var tpl: Dictionary = gen["town"]["templates"][cfg["template"]]
	var names: Array = cfg["names"]
	var half := float(cfg["half_size_m"])
	var labels: Dictionary = gen["town"].get("labels", {})
	var lane := float(gen["extra_cover"]["lane_gap_m"]) if gen.has("extra_cover") else -1.0
	for f in names.size():
		var p := dir_of(float(cfg["first_bearing_deg"]) + 360.0 / names.size() * f) * float(cfg["radius_m"])
		var centre := Vector2(snappedf(p.x, 0.5), snappedf(p.y, 0.5))
		var rect := Rect2(centre - Vector2(half, half), Vector2(half, half) * 2.0)
		var quarter := _quarter_facing_centre(centre)
		var fit := _fit_layout(state, _template_layout(tpl, centre, quarter, f, ctx), rect, true)
		var prefix := "Villa%d" % (f + 1)
		for line: String in fit["dropped"]:
			(out["dropped"] as Array).append("%s (%s) q%d: %s" % [prefix, names[f], quarter, line])
		_emit(fit["kept"], prefix, labels, structures, cover, "Cover_%03d", state["cover_types"])
		(out["farms"] as Array).append({"name": String(names[f]), "prefix": prefix, "centre": centre, "rect": rect, "quarter": quarter,
			"kept": (fit["kept"] as Array).size(), "dropped": (fit["dropped"] as Array).size()})
	var first := cover.size()
	for farm: Dictionary in out["farms"]:
		_cover(state, cover, "Cover_%03d", cfg["cover_types"], int(cfg["cover"]), _rect_sampler(farm["rect"]), "%s cover" % farm["prefix"], farm["rect"], lane)
	out["farm_cover"] = cover.size() - first


## M2 L2a density pass: the place nearest (bearing_deg, radius_m) where the layout `make.call(centre)` (its block
## a Rect2 of half size `half` round the centre; Rect2() = no block) drops the fewest pieces: bearings tried 0, +s, -s,
## +2s, ... (search.bearing_step_deg x bearing_steps) and radii likewise (radius_step_m x radius_steps), centres
## snapped to 0.5 m; the first spot that drops nothing wins. Returns {centre, layout, rect, dropped (count)}.
static func _search_spot(state: Dictionary, bearing: float, radius: float, search: Dictionary, half: Vector2, make: Callable, own_gap: float) -> Dictionary:
	var best := {}
	var nb := int(search.get("bearing_steps", 0))
	var nr := int(search.get("radius_steps", 0))
	for i in 2 * nb + 1:
		var db := float(search.get("bearing_step_deg", 0.0)) * floorf((i + 1) * 0.5) * (1.0 if i % 2 == 1 else -1.0)
		for j in 2 * nr + 1:
			var dr := float(search.get("radius_step_m", 0.0)) * floorf((j + 1) * 0.5) * (1.0 if j % 2 == 1 else -1.0)
			var p := dir_of(bearing + db) * (radius + dr)
			var centre := Vector2(snappedf(p.x, 0.5), snappedf(p.y, 0.5))
			var layout: Array = make.call(centre)
			var rect := Rect2(centre - half, half * 2.0) if half != Vector2.ZERO else Rect2()
			var n := (_fit_layout(state, layout, rect, false, own_gap)["dropped"] as Array).size()
			if best.is_empty() or n < int(best["dropped"]):
				best = {"centre": centre, "layout": layout, "rect": rect, "dropped": n}
			if n == 0:
				return best
	return best


## M2 L2a (generator.statio): a picket post behind each camp (at the camp's bearing, radius_m out), laid out from
## statio.pieces (block frame, front = -z to the map centre, half_size_m) with own_gap_m between its own pieces (a
## sandbag nest's three pieces), placed at the search spot that drops the fewest; pieces "Statio<k>_<label>_<n>"
## and cover. The blocks join `blocks` (the field passes keep out).
static func _statio(state: Dictionary, structures: Array, cover: Array, ctx: Dictionary, camp_centres: Array[Vector2], out: Dictionary, blocks: Array[Rect2]) -> void:
	var gen: Dictionary = state["gen"]
	var cfg: Dictionary = gen["statio"]
	var half := Vector2.ONE * float(cfg["half_size_m"])
	var own := float(cfg["own_gap_m"])
	for c in camp_centres.size():
		var bearing := float(gen["camps"]["first_bearing_deg"]) + 60.0 * c
		var make := func(centre: Vector2) -> Array: return _template_layout(cfg, centre, _quarter_facing_centre(centre), c, ctx)
		var spot := _search_spot(state, bearing, float(cfg["radius_m"]), cfg.get("search", {}), half, make, own)
		var fit := _fit_layout(state, spot["layout"], spot["rect"], true, own)
		var prefix := "Statio%d" % (c + 1)
		for line: String in fit["dropped"]:
			(out["dropped"] as Array).append("%s: %s" % [prefix, line])
		_emit(fit["kept"], prefix, gen["town"].get("labels", {}), structures, cover, "Cover_%03d", state["cover_types"])
		blocks.append(spot["rect"])
		(out["posts"] as Array).append({"prefix": prefix, "centre": spot["centre"], "kept": (fit["kept"] as Array).size(), "dropped": (fit["dropped"] as Array).size()})


## M2 L2a (generator.farmsteads.small): more, smaller farmsteads ("Villa<k>", k continuing after the six) at the
## search spot nearest each of small.spots, laid out from town.templates[small.template] (front to the map centre),
## then small.cover random pieces inside each block. They join out.farms (chests per farmstead, field passes avoid).
static func _farmsteads_small(state: Dictionary, structures: Array, cover: Array, ctx: Dictionary, out: Dictionary) -> void:
	var gen: Dictionary = state["gen"]
	var cfg: Dictionary = gen["farmsteads"]["small"]
	var tpl: Dictionary = gen["town"]["templates"][cfg["template"]]
	var half := Vector2.ONE * float(cfg["half_size_m"])
	var labels: Dictionary = gen["town"].get("labels", {})
	var lane := float(gen["extra_cover"]["lane_gap_m"]) if gen.has("extra_cover") else -1.0
	var first_farm := (out["farms"] as Array).size()
	for s in (cfg["spots"] as Array).size():
		var k := first_farm + s
		var spot_cfg: Dictionary = cfg["spots"][s]
		var make := func(centre: Vector2) -> Array: return _template_layout(tpl, centre, _quarter_facing_centre(centre), k, ctx)
		var spot := _search_spot(state, float(spot_cfg["bearing_deg"]), float(spot_cfg["radius_m"]), cfg.get("search", {}), half, make, -1.0)
		var fit := _fit_layout(state, spot["layout"], spot["rect"], true)
		var prefix := "Villa%d" % (k + 1)
		for line: String in fit["dropped"]:
			(out["dropped"] as Array).append("%s (%s): %s" % [prefix, cfg["names"][s], line])
		_emit(fit["kept"], prefix, labels, structures, cover, "Cover_%03d", state["cover_types"])
		(out["farms"] as Array).append({"name": String(cfg["names"][s]), "prefix": prefix, "centre": spot["centre"], "rect": spot["rect"],
			"quarter": _quarter_facing_centre(spot["centre"]), "kept": (fit["kept"] as Array).size(), "dropped": (fit["dropped"] as Array).size()})
		out["small_farms"] = int(out["small_farms"]) + 1
	var first := cover.size()
	for f in range(first_farm, (out["farms"] as Array).size()):
		var farm: Dictionary = out["farms"][f]
		_cover(state, cover, "Cover_%03d", cfg["cover_types"], int(cfg["cover"]), _rect_sampler(farm["rect"]), "%s cover" % farm["prefix"], farm["rect"], lane)
	out["farm_cover"] = int(out["farm_cover"]) + cover.size() - first


## M2 L2a (generator.vineae): vineyard / crop plots, each `rows` parallel rows of `per_row` stake_row pieces end to end
## (end_gap_m apart), row_pitch_m between rows (walkable lanes), along x or z (plot "along"; default: the ring's
## tangent snapped to an axis), at the search spot nearest each plot's bearing and radius. Structures
## "Vinea<k>_Stakes_<n>"; own pieces keep end_gap_m, everything else placement.minimum_gap_m.
static func _vineae(state: Dictionary, structures: Array, out: Dictionary, blocks: Array[Rect2]) -> void:
	var cfg: Dictionary = state["gen"]["vineae"]
	var kit: Dictionary = WorldKit.config()["types"]
	var length := float(kit["stake_row"]["colliders"][0]["size"][0])
	var own := float(cfg["end_gap_m"])
	for k in (cfg["plots"] as Array).size():
		var plot: Dictionary = cfg["plots"][k]
		var rows := int(plot.get("rows", cfg["rows"]))
		var per_row := int(cfg["per_row"])
		var tangent := right_of(float(plot["bearing_deg"]))
		var along_x := String(plot.get("along", "x" if absf(tangent.x) >= absf(tangent.y) else "z")) == "x"
		var make := func(centre: Vector2) -> Array:
			var layout: Array = []
			for r in rows:
				var across := (r - (rows - 1) * 0.5) * float(cfg["row_pitch_m"])
				for i in per_row:
					var on := (i - (per_row - 1) * 0.5) * (length + own)
					var p := centre + (Vector2(on, across) if along_x else Vector2(across, on))
					var at := Vector2(_r3(p.x), _r3(p.y))
					var yaw := 0.0 if along_x else 90.0
					layout.append({"structure": true, "type": "stake_row", "at": at, "yaw": yaw, "rect": WorldKit.footprint(kit["stake_row"], Vector3(at.x, 0.0, at.y), yaw), "aprons": [] as Array[Rect2]})
			return layout
		var spot := _search_spot(state, float(plot["bearing_deg"]), float(plot["radius_m"]), cfg.get("search", {}), Vector2.ZERO, make, own)
		var fit := _fit_layout(state, spot["layout"], Rect2(), true, own)
		var prefix := "Vinea%d" % (k + 1)
		for line: String in fit["dropped"]:
			(out["dropped"] as Array).append("%s: %s" % [prefix, line])
		var bounds := Rect2()
		var n := 0
		for e: Dictionary in fit["kept"]:
			structures.append({"id": "%s_Stakes_%d" % [prefix, n], "type": "stake_row", "at": [(e["at"] as Vector2).x, 0.0, (e["at"] as Vector2).y], "yaw": float(e["yaw"])})
			bounds = e["rect"] if n == 0 else bounds.merge(e["rect"])
			n += 1
		if n > 0:
			blocks.append(bounds)
		(out["plots"] as Array).append({"prefix": prefix, "centre": spot["centre"], "kept": n, "dropped": (fit["dropped"] as Array).size()})


## M2 L2a (generator.town.fill): the town grid's cells that were not built (no template) whose centre lies
## fill.from_m..fill.to_m out get a half block (template fill.template, block_m x block_m / 2, front = -z to the
## block's edge): of the four halves the ones keeping town.inner_clear_m from the centre and town.camp_clear_m from the
## camp blocks are tried, the one dropping the fewest wins, kept when it drops at most fill.max_dropped. Pieces
## "Oppidum<n>" continuing the cells' numbers, then fill.cover random pieces in the half.
static func _town_fill(state: Dictionary, structures: Array, cover: Array, ctx: Dictionary, camp_blocks: Array[Rect2], out: Dictionary) -> void:
	var town: Dictionary = state["gen"]["town"]
	var cfg: Dictionary = town["fill"]
	var tpl: Dictionary = town["templates"][cfg["template"]]
	var pitch := float(town["pitch_m"])
	var block := float(town["block_m"])
	var offset := float(town["cell_offset_m"])
	var built := {}
	for cell: Dictionary in out["cells"]:
		built[cell["centre"]] = true
	var reach := ceili(float(cfg["to_m"]) / pitch) + 1
	var todo: Array = []
	for j in range(-reach, reach + 1):
		for i in range(-reach, reach + 1):
			var c := Vector2(offset + pitch * i, offset + pitch * j)
			if not built.has(c) and c.length() >= float(cfg["from_m"]) and c.length() <= float(cfg["to_m"]):
				todo.append(c)
	todo.sort_custom(func(a: Vector2, b: Vector2) -> bool: return fposmod(atan2(a.x, -a.y), TAU) < fposmod(atan2(b.x, -b.y), TAU))
	var index := (out["cells"] as Array).size()
	var lane := _town_lane(state["gen"])
	for c: Vector2 in todo:
		var best := {}
		for q in 4:
			var mid := c + _quarter(Vector2(0.0, -block * 0.25), q)
			var size := Vector2(block, block * 0.5) if q % 2 == 0 else Vector2(block * 0.5, block)
			var rect := Rect2(mid - size * 0.5, size)
			if WorldRing.rect_distance(Vector2.ZERO, rect) < float(town["inner_clear_m"]):
				continue
			var clear := true
			for camp in camp_blocks:
				clear = clear and WorldRing.rect_gap(rect, camp) >= float(town["camp_clear_m"])
			if not clear:
				continue
			var layout := _template_layout(tpl, mid, q, index, ctx)
			var n := (_fit_layout(state, layout, rect, false)["dropped"] as Array).size()
			if best.is_empty() or n < int(best["dropped"]):
				best = {"layout": layout, "rect": rect, "dropped": n, "q": q}
		if best.is_empty() or int(best["dropped"]) > int(cfg["max_dropped"]):
			continue
		var fit := _fit_layout(state, best["layout"], best["rect"], true)
		var prefix := "Oppidum%02d" % index
		for line: String in fit["dropped"]:
			(out["dropped"] as Array).append("%s %s q%d: %s" % [prefix, cfg["template"], int(best["q"]), line])
		_emit(fit["kept"], prefix, town.get("labels", {}), structures, cover, "Cover_%03d", state["cover_types"])
		_cover(state, cover, "Cover_%03d", town["cover_types"], int(cfg.get("cover", 0)), _rect_sampler(best["rect"]), "town %s cover" % prefix, best["rect"], lane)
		(out["fills"] as Array).append({"prefix": prefix, "centre": c, "q": int(best["q"]), "kept": (fit["kept"] as Array).size(), "dropped": (fit["dropped"] as Array).size()})
		index += 1


## M2 L2a (generator.density_check, report only): the largest squares of the fields band (from_m..to_m, outside the
## main streets |x|, |z| < street_half_m) with no footprint at all (state.placed: every piece, aprons included), on a
## cell_m grid, greedily: [[side_m, centre]] for every square of at least report_m, largest first.
static func _bare_squares(state: Dictionary) -> Array:
	var cfg: Dictionary = state["gen"]["density_check"]
	var cell := float(cfg["cell_m"])
	var r0 := float(cfg["from_m"])
	var r1 := float(cfg["to_m"])
	var street := float(cfg["street_half_m"])
	var half := r1 + cell
	var n := ceili(2.0 * half / cell)
	var free := PackedByteArray()
	free.resize(n * n)
	for j in n:
		for i in n:
			var p := Vector2(-half + (i + 0.5) * cell, -half + (j + 0.5) * cell)
			free[j * n + i] = 1 if p.length() >= r0 and p.length() <= r1 and absf(p.x) > street and absf(p.y) > street else 0
	for r: Rect2 in state["placed"]:
		var i0 := clampi(floori((r.position.x + half) / cell), 0, n - 1)
		var i1 := clampi(floori((r.end.x + half) / cell), 0, n - 1)
		var j0 := clampi(floori((r.position.y + half) / cell), 0, n - 1)
		var j1 := clampi(floori((r.end.y + half) / cell), 0, n - 1)
		for j in range(j0, j1 + 1):
			for i in range(i0, i1 + 1):
				free[j * n + i] = 0
	var want := ceili(float(cfg["report_m"]) / cell)
	var found: Array = []
	for _round in 64:
		var side := PackedInt32Array()
		side.resize(n * n)
		var best := 0
		var best_at := Vector2i.ZERO
		for j in n:
			for i in n:
				if free[j * n + i] == 0:
					continue
				var s := 1
				if i > 0 and j > 0:
					s = 1 + mini(side[j * n + i - 1], mini(side[(j - 1) * n + i], side[(j - 1) * n + i - 1]))
				side[j * n + i] = s
				if s > best:
					best = s
					best_at = Vector2i(i, j)
		if best < want:
			break
		var centre := Vector2(-half + (best_at.x + 1 - best * 0.5) * cell, -half + (best_at.y + 1 - best * 0.5) * cell)
		found.append([best * cell, centre])
		for j in range(best_at.y - best + 1, best_at.y + 1):
			for i in range(best_at.x - best + 1, best_at.x + 1):
				free[j * n + i] = 0
	return found


## M2 L2a: the field wall runs (generator.field_walls): `runs` runs, each of pieces_min..pieces_max unturned cover
## boxes in a straight line with gap_min_m..gap_max_m between them (never end to end), centred on a seeded point of
## the field ring (outside the camp and farmstead blocks), along the ring's tangent there (tangent_share of the runs)
## or along its radius, snapped to the nearer axis: x_types along x, z_types along z (the cover file has no yaw). A run
## is placed whole or retried (placement.max_attempts); pieces "Ring_%03d" in ring_pieces.
static func _field_walls(state: Dictionary, ring_pieces: Array, out: Dictionary) -> void:
	var gen: Dictionary = state["gen"]
	var cfg: Dictionary = gen["field_walls"]
	var rng: RandomNumberGenerator = state["rng"]
	var types: Dictionary = state["cover_types"]
	var place: Dictionary = gen["placement"]
	var placed: Array[Rect2] = state["placed"]
	var sampler := _field_ring(state, float(cfg["from_m"]), float(cfg["to_m"]))
	var gap := float(place["minimum_gap_m"])
	var runs := 0
	var pieces := 0
	for run in int(cfg["runs"]):
		for attempt in int(place["max_attempts"]):
			var raw: Vector2 = sampler.call(rng)
			var centre := Vector2(snappedf(raw.x, float(place["snap_m"])), snappedf(raw.y, float(place["snap_m"])))
			var radial := centre.normalized()
			var d := Vector2(-radial.y, radial.x) if rng.randf() < float(cfg["tangent_share"]) else radial
			var along_x := absf(d.x) >= absf(d.y)
			var axis := Vector2(1.0, 0.0) if along_x else Vector2(0.0, 1.0)
			var names: Array = cfg["x_types"] if along_x else cfg["z_types"]
			var n := rng.randi_range(int(cfg["pieces_min"]), int(cfg["pieces_max"]))
			var spacing := snappedf(rng.randf_range(float(cfg["gap_min_m"]), float(cfg["gap_max_m"])), 0.1)
			var first_type := rng.randi_range(0, names.size() - 1)
			var run_types: Array[String] = []
			var lengths: Array[float] = []
			var total := spacing * (n - 1)
			for i in n:
				var t := String(names[(first_type + i) % names.size()])
				var size := LowpolyKit.vec(types[t]["size"])
				run_types.append(t)
				lengths.append(size.x if along_x else size.z)
				total += lengths[i]
			var u := -total * 0.5
			var entries: Array = []
			var rects: Array[Rect2] = []
			for i in n:
				var at := centre + axis * (u + lengths[i] * 0.5)
				at = Vector2(_r3(at.x), _r3(at.y))
				var rect := _box_rect(at, LowpolyKit.vec(types[run_types[i]]["size"]), 0.0)
				if _misfit(state, placed, at, rect, Rect2(), gap) != "":
					entries.clear()
					break
				entries.append({"type": run_types[i], "at": [at.x, float(types[run_types[i]]["size"][1]) * 0.5, at.y]})
				rects.append(rect)
				u += lengths[i] + spacing
			if entries.size() != n:
				continue
			for i in n:
				entries[i]["id"] = "Ring_%03d" % ring_pieces.size()
				ring_pieces.append(entries[i])
			placed.append_array(rects)
			runs += 1
			pieces += n
			break
	out["field_walls"] = runs
	out["field_wall_pieces"] = pieces
	if runs < int(cfg["runs"]):
		_note(state, "shortfalls", "field wall runs: %d of %d" % [runs, int(cfg["runs"])])


## M2 L2a: the gap the town's random pieces (cover, breakables, district chests) keep inside a cell: town.lane_gap_m,
## else extra_cover.lane_gap_m, else placement.minimum_gap_m (-1).
static func _town_lane(gen: Dictionary) -> float:
	if (gen.get("town", {}) as Dictionary).has("lane_gap_m"):
		return float(gen["town"]["lane_gap_m"])
	return float(gen["extra_cover"]["lane_gap_m"]) if gen.has("extra_cover") else -1.0


## M2 L2a: breakables in every town cell (generator.town.breakables_per_cell, cycled over the cells in order), inside
## the block with extra_cover.lane_gap_m, continuing the "Breakable_%03d" entries; counts["town"]. Nothing without it.
static func _breakables_500(state: Dictionary, props: Dictionary, l500: Dictionary) -> void:
	var gen: Dictionary = state["gen"]
	if l500.is_empty() or not gen.has("props") or (l500["cells"] as Array).is_empty():
		return
	var per_cell: Array = gen["town"].get("breakables_per_cell", [])
	if per_cell.is_empty():
		return
	var cfg: Dictionary = gen["props"]["breakables"]
	var entries: Array = props["entries"]
	var first := entries.size()
	var lane := _town_lane(gen)
	for k in (l500["cells"] as Array).size():
		var cell: Dictionary = l500["cells"][k]
		_breakable(state, entries, cfg["types"], gen["props"]["types"], int(per_cell[k % per_cell.size()]), _rect_sampler(cell["rect"]), "town %s breakables" % cell["prefix"], cell["rect"], lane)
	props["counts"]["town"] = entries.size() - first


## M2 L2a: chests in each district cell (props.chests.districts per named town landmark) and each farmstead
## (props.chests.farmsteads), inside the block with extra_cover.lane_gap_m, continuing the "Chest_%03d" entries;
## counts["districts"], counts["farmsteads"]. Nothing without those keys.
static func _chests_500(state: Dictionary, chest_pass: Dictionary, l500: Dictionary) -> void:
	var gen: Dictionary = state["gen"]
	if l500.is_empty() or not gen.has("props") or not (gen["props"] as Dictionary).has("chests"):
		return
	var cfg: Dictionary = gen["props"]["chests"]
	var entries: Array = chest_pass["entries"]
	var lane := float(gen["extra_cover"]["lane_gap_m"]) if gen.has("extra_cover") else -1.0
	var areas := {"districts": [], "farmsteads": []}
	for cell: Dictionary in l500["cells"]:
		if cell.has("landmark"):
			(areas["districts"] as Array).append(cell)
	areas["farmsteads"] = l500["farms"]
	for area: String in areas:
		if not cfg.has(area):
			continue
		var first := entries.size()
		var gap := _town_lane(gen) if area == "districts" else lane
		for block: Dictionary in areas[area]:
			_chest(state, entries, cfg["size"], float(cfg["front_clear_m"]), int(cfg[area]), _rect_sampler(block["rect"]), "%s chests" % block["prefix"], block["rect"], gap)
		chest_pass["counts"][area] = entries.size() - first


## M2 L2a: the report lines of the 500 m passes (none for a map without them): the laid-out counts, structures by
## type, the town's cells per template and every dropped template piece.
static func report_500(out: Dictionary) -> PackedStringArray:
	var lines := PackedStringArray()
	var l500: Dictionary = out.get("l500", {})
	if l500.is_empty():
		return lines
	var by_type := {}
	for entry: Dictionary in out["structures"]["pieces"]:
		by_type[entry["type"]] = int(by_type.get(entry["type"], 0)) + 1
	var cover_file: Dictionary = out["cover"]
	lines.append("GEN_ALESIA 500: arx_ring=%d camp_extras=%d town_cells=%d district_landmarks=%d town_cover=%d farmsteads=%d farm_cover=%d field_walls=%d runs (%d pieces) outside_stakes=%d dropped=%d" % [
		int(l500["arx_pieces"]), int(l500["camp_extras"]), (l500["cells"] as Array).size(), int(l500["districts"]), int(l500["town_cover"]),
		(l500["farms"] as Array).size(), int(l500["farm_cover"]), int(l500["field_walls"]), int(l500["field_wall_pieces"]), int(l500["outside_stakes"]),
		(l500["dropped"] as Array).size()])
	lines.append("GEN_ALESIA 500 town per template: %s" % str(l500.get("town_counts", {})))
	lines.append("GEN_ALESIA 500 structures by type: %s" % str(by_type))
	lines.append("GEN_ALESIA 500 files: cover=%d ring=%d decor=%d breakables=%d chests=%d doors=%d ladders=%d cover_walls=%d breakable_counts=%s chest_counts=%s" % [
		(cover_file["pieces"] as Array).size(), (cover_file["ring_pieces"] as Array).size(), (cover_file["decor"] as Array).size(),
		(cover_file.get("breakables", []) as Array).size(), (cover_file.get("chests", []) as Array).size(), (cover_file.get("doors", []) as Array).size(),
		(cover_file.get("ladders", []) as Array).size(), int(out["cover_walls"]), str(out["breakables"]), str(out["chests"])])
	for cell: Dictionary in l500["cells"]:
		lines.append("GEN_ALESIA 500 cell %s %s at (%d, %d) bearing %.1f q%d kept=%d dropped=%d" % [cell["prefix"], cell["template"],
			int((cell["centre"] as Vector2).x), int((cell["centre"] as Vector2).y), float(cell["bearing"]), int(cell["quarter"]), int(cell["kept"]), int(cell["dropped"])])
	for farm: Dictionary in l500["farms"]:
		lines.append("GEN_ALESIA 500 farm %s (%s) at %s q%d kept=%d dropped=%d" % [farm["prefix"], farm["name"], str(farm["centre"]), int(farm["quarter"]), int(farm["kept"]), int(farm["dropped"])])
	var plot_pieces := 0
	for plot: Dictionary in l500["plots"]:
		plot_pieces += int(plot["kept"])
	lines.append("GEN_ALESIA 500 density: posts=%d plots=%d (%d stake rows) small_farms=%d town_fills=%d contact_rejects=%d bare_squares=%d" % [
		(l500["posts"] as Array).size(), (l500["plots"] as Array).size(), plot_pieces, int(l500["small_farms"]),
		(l500["fills"] as Array).size(), int(out.get("contact_rejects", 0)), (out.get("bare", []) as Array).size()])
	for post: Dictionary in l500["posts"]:
		lines.append("GEN_ALESIA 500 post %s at %s kept=%d dropped=%d" % [post["prefix"], str(post["centre"]), int(post["kept"]), int(post["dropped"])])
	for plot: Dictionary in l500["plots"]:
		lines.append("GEN_ALESIA 500 plot %s at %s kept=%d dropped=%d" % [plot["prefix"], str(plot["centre"]), int(plot["kept"]), int(plot["dropped"])])
	for fill: Dictionary in l500["fills"]:
		lines.append("GEN_ALESIA 500 fill %s at %s q%d kept=%d dropped=%d" % [fill["prefix"], str(fill["centre"]), int(fill["q"]), int(fill["kept"]), int(fill["dropped"])])
	for sq: Array in out.get("bare", []):
		lines.append("GEN_ALESIA 500 bare square %.0f m at %s" % [float(sq[0]), str(sq[1])])
	for line: String in l500["dropped"]:
		lines.append("GEN_ALESIA 500 dropped: " + line)
	return lines
