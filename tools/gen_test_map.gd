extends SceneTree
## M2P1A: writes the pieces of the TEST-ONLY 300 m performance map (data/maps/test_300.json) from the numbers in
## its "generator" block: data/maps/test_300_cover.json (pieces, ring_pieces, decor) and
## data/maps/test_300_structures.json (pieces). Not a design layout: alesia's density per area spread over a larger
## square, with alesia's own types. Deterministic: one seeded RandomNumberGenerator and a fixed order of work.
## godot --headless --path . --script res://tools/gen_test_map.gd

const MAP_PATH := "res://data/maps/test_300.json"
const COVER_OUT := "res://data/maps/test_300_cover.json"
const STRUCTURES_OUT := "res://data/maps/test_300_structures.json"
const COVER_TYPES := "res://data/maps/alesia_cover.json"
const NOTE := "TEST-ONLY performance map pieces, generated by tools/gen_test_map.gd from data/maps/test_300.json \"generator\"; do not edit by hand."


func _initialize() -> void:
	var map_def := DataRegistry.parse_quiet(MAP_PATH)
	var gen: Dictionary = map_def.get("generator", {})
	var out := generate(map_def)
	_write(COVER_OUT, out["cover"])
	_write(STRUCTURES_OUT, out["structures"])
	var counts := counts_of(out)
	var targets: Dictionary = gen["targets"]
	var short := false
	for key: String in targets:
		short = short or float(counts[key]) < float(targets[key]) * (1.0 - float(gen["tolerance"]))
	print("GEN_TEST_MAP seed=%d cover=%d ring=%d decor=%d structures=%d ground_rejects=%d" % [int(gen["seed"]), counts["cover"], counts["ring"], counts["decor"], counts["structures"], int(out["ground_rejects"])])
	quit(1 if short else 0)


static func _write(path: String, data: Dictionary) -> void:
	var f := FileAccess.open(path, FileAccess.WRITE)
	f.store_string(JSON.stringify(data, "\t") + "\n")
	f.close()


## Placed counts per list: {cover, ring, decor, structures}.
static func counts_of(out: Dictionary) -> Dictionary:
	return {
		"cover": (out["cover"]["pieces"] as Array).size(),
		"ring": (out["cover"]["ring_pieces"] as Array).size(),
		"decor": (out["cover"]["decor"] as Array).size(),
		"structures": (out["structures"]["pieces"] as Array).size(),
	}


## The two piece files of the map, built in memory: {"cover": cover file, "structures": structures file}.
## Touches no file except the type files it reads.
static func generate(map_def: Dictionary) -> Dictionary:
	var gen: Dictionary = map_def["generator"]
	var targets: Dictionary = gen["targets"]
	var rng := RandomNumberGenerator.new()
	rng.seed = int(gen["seed"])
	var half := float(gen["ground_size_m"]) * 0.5
	var split := float(gen["split_m"])
	var inner := Rect2(-split, -split, split * 2.0, split * 2.0)
	var cover_cfg := DataRegistry.parse_quiet(COVER_TYPES)
	var cover_types: Dictionary = cover_cfg["types"]
	var kit := WorldKit.config()
	var kit_types: Dictionary = kit["types"]
	var yaw_step := float(kit["rules"]["yaw_step_deg"])
	var state := {
		"rng": rng,
		"gen": gen,
		"half": half,
		"placed": [] as Array[Rect2],
		"spots": spots_of(map_def),
		"terrain": MapTerrain.for_map(map_def),  # M2P1B: null on a flat map (no ground filter)
		"ground_rejects": 0,
	}
	# Structures first: they are the largest. The round-robin list is ordered by ground area (largest first).
	var kit_names := _sorted_keys(kit_types)
	var kit_list: Array = []
	for i in int(targets["structures"]):
		kit_list.append(kit_names[i % kit_names.size()])
	var area := {}
	for type: String in kit_names:
		area[type] = WorldKit.footprint(kit_types[type], Vector3.ZERO, 0.0).get_area()
	kit_list.sort_custom(func(a: String, b: String) -> bool: return area[a] > area[b] or (area[a] == area[b] and a < b))
	var structures: Array = []
	for type: String in kit_list:
		var definition: Dictionary = kit_types[type]
		var spot: Variant = _place(state, Rect2(-half, -half, half * 2.0, half * 2.0), func(at: Vector2, yaw: float) -> Rect2:
				return WorldKit.footprint(definition, Vector3(at.x, 0.0, at.y), yaw), yaw_step, Rect2())
		if spot != null:
			structures.append({"id": "Kit_%03d" % structures.size(), "type": type, "at": [spot[0].x, 0.0, spot[0].y], "yaw": spot[1]})
	var cover_names := _sorted_keys(cover_types)
	var cover := _place_cover(state, "Cover_%03d", cover_names, cover_types, int(targets["cover"]), inner, Rect2())
	var ring := _place_cover(state, "Ring_%03d", cover_names, cover_types, int(targets["ring"]), Rect2(-half, -half, half * 2.0, half * 2.0), inner)
	# Decor: copies of alesia's distinct decor templates (kind, size, y), round-robin by template key.
	var templates := {}
	for entry: Dictionary in cover_cfg["decor"]:
		var key := "%s %s %s" % [entry["kind"], str(entry["size"]), str(entry["at"][1])]
		if not templates.has(key):
			templates[key] = entry
	var template_keys := _sorted_keys(templates)
	var decor: Array = []
	for i in int(targets["decor"]):
		var template: Dictionary = templates[template_keys[i % template_keys.size()]]
		var size := LowpolyKit.vec(template["size"])
		var spot: Variant = _place(state, Rect2(-half, -half, half * 2.0, half * 2.0), func(at: Vector2, yaw: float) -> Rect2:
				return _box_rect(at, size, yaw), yaw_step, Rect2())
		if spot != null:
			decor.append({"id": "Decor_%03d" % decor.size(), "kind": template["kind"], "size": (template["size"] as Array).duplicate(), "at": [spot[0].x, float(template["at"][1]), spot[0].y], "yaw": spot[1]})
	var cover_file := {"version": 1, "_placeholder": true, "_note": NOTE, "pieces": cover, "ring_pieces": ring, "decor": decor}
	var structure_file := {"version": 1, "_placeholder": true, "_note": NOTE, "pieces": structures}
	return {"cover": cover_file, "structures": structure_file, "ground_rejects": int(state["ground_rejects"])}


## Spawn spots sorted by id, on the ground plane (x, z).
static func spots_of(map_def: Dictionary) -> Array[Vector2]:
	var spawns: Dictionary = map_def["spawns"]
	var out: Array[Vector2] = []
	for id: String in _sorted_keys(spawns):
		out.append(Vector2(float(spawns[id][0]), float(spawns[id][2])))
	return out


static func _sorted_keys(dict: Dictionary) -> Array:
	var keys: Array = []
	for key: String in dict:
		if not key.begins_with("_"):
			keys.append(key)
	keys.sort()
	return keys


## Ground rectangle of a box of `size` turned by a multiple of 90 degrees around its centre `at`.
static func _box_rect(at: Vector2, size: Vector3, yaw: float) -> Rect2:
	var quarter := posmod(roundi(yaw / 90.0), 2) == 1
	var w := size.z if quarter else size.x
	var d := size.x if quarter else size.z
	return Rect2(at.x - w * 0.5, at.y - d * 0.5, w, d)


## Cover or ring cover ({id, type, at}; no yaw; standing on the ground): `count` pieces, types round-robin.
static func _place_cover(state: Dictionary, id_format: String, names: Array, types: Dictionary, count: int, area: Rect2, keep_out: Rect2) -> Array:
	var out: Array = []
	for i in count:
		var type: String = names[i % names.size()]
		var size := LowpolyKit.vec(types[type]["size"])
		var spot: Variant = _place(state, area, func(at: Vector2, _yaw: float) -> Rect2:
				return _box_rect(at, size, 0.0), 0.0, keep_out)
		if spot != null:
			# y from the json number (64-bit), not the 32-bit Vector3, so the file keeps short numbers.
			out.append({"id": id_format % out.size(), "type": type, "at": [spot[0].x, float(types[type]["size"][1]) * 0.5, spot[0].y]})
	return out


## Rejection sampling: up to max_attempts snapped candidates in `area` (yaw in steps of `yaw_step`, 0 = none). A
## candidate's footprint must lie inside `area` and inside the ground less the edge margin, must not touch
## `keep_out`, must keep the minimum gap from every footprint placed so far and the spawn and lane clearances,
## and must stand on fit ground (ground_fits). Returns [Vector2 at, float yaw] and records the footprint, or null.
static func _place(state: Dictionary, area: Rect2, footprint: Callable, yaw_step: float, keep_out: Rect2) -> Variant:
	var rng: RandomNumberGenerator = state["rng"]
	var gen: Dictionary = state["gen"]
	var half: float = state["half"]
	var snap := float(gen["snap_m"])
	var margin := float(gen["edge_margin_m"])
	var gap := float(gen["minimum_gap_m"])
	var spawn_clear := float(gen["spawn_clear_m"])
	var lane_clear := float(gen["lane_clear_m"])
	var ground := Rect2(-half + margin, -half + margin, (half - margin) * 2.0, (half - margin) * 2.0)
	var placed: Array[Rect2] = state["placed"]
	var spots: Array[Vector2] = state["spots"]
	var steps := int(round(360.0 / yaw_step)) if yaw_step > 0.0 else 1
	for attempt in int(gen["max_attempts"]):
		var at := Vector2(snappedf(rng.randf_range(area.position.x, area.end.x), snap), snappedf(rng.randf_range(area.position.y, area.end.y), snap))
		var yaw := float(rng.randi_range(0, steps - 1)) * yaw_step if yaw_step > 0.0 else 0.0
		var rect: Rect2 = footprint.call(at, yaw)
		if not area.encloses(rect) or not ground.encloses(rect):
			continue
		if keep_out.has_area() and rect.intersects(keep_out, true):
			continue
		if not _clear(rect, spots, spawn_clear, lane_clear):
			continue
		if not ground_fits(state["terrain"], at, rect):
			state["ground_rejects"] = int(state["ground_rejects"]) + 1
			continue
		var free := true
		for other in placed:
			if WorldRing.rect_gap(rect, other) < gap:
				free = false
				break
		if free:
			placed.append(rect)
			return [at, yaw]
	return null


## M2P1B: true when a piece at `at` with footprint `rect` can stand on `terrain` (always on a flat map): the slope
## at its origin and at every footprint corner is at most max_piece_slope_deg, and no corner's ground is more
## than max_piece_float_m above or below the ground at its origin (the builder lifts a piece by that origin height,
## so a corner would otherwise float or sink).
static func ground_fits(terrain: MapTerrain, at: Vector2, rect: Rect2) -> bool:
	if terrain == null:
		return true
	if terrain.slope_deg_at(at.x, at.y) > terrain.max_piece_slope_deg:
		return false
	var origin := terrain.height_at(at.x, at.y)
	for corner: Vector2 in [rect.position, Vector2(rect.end.x, rect.position.y), Vector2(rect.position.x, rect.end.y), rect.end]:
		if terrain.slope_deg_at(corner.x, corner.y) > terrain.max_piece_slope_deg:
			return false
		if absf(terrain.height_at(corner.x, corner.y) - origin) > terrain.max_piece_float_m:
			return false
	return true


## True when `rect` keeps `spawn_clear` from every spot and `lane_clear` from the line between neighbouring spots
## (sorted by id, each to the next, the last to the first).
static func _clear(rect: Rect2, spots: Array[Vector2], spawn_clear: float, lane_clear: float) -> bool:
	for s in spots.size():
		if WorldRing.rect_distance(spots[s], rect) < spawn_clear:
			return false
		var a := spots[s]
		var b := spots[(s + 1) % spots.size()]
		var lane := Rect2(a, Vector2.ZERO).expand(b).grow(lane_clear)
		if lane.intersects(rect, true) and WorldRing.rect_segment_distance(rect, a, b) < lane_clear:
			return false
	return true
