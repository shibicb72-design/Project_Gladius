extends SceneTree
## M2 Z1: writes a map's zone phases (overrides.br.zone.phases in the map json) from the numbers in the map's
## top-level "zone_gen" block, so the phases are never typed by hand. Every input is a guess (OQ-BR-ZONE).
## godot --headless --path . --script res://tools/gen_zone.gd [-- --map=res://data/maps/<file>.json]
## Without --map it writes DEFAULT_MAP. After a change, re-run tools/bake_nav.gd for the map (the saved-nav
## manifest hashes the whole map json).
##
## The rules, per phase i (r_prev = the previous radius, the play radius for the first phase):
## - radius_m = radius_fraction x play_radius_m, rounded to 0.1 m (the last is exactly 0);
## - a phase's centre may move by up to (r_prev - r) (BrRules._generate_circles), so its edge moves up to
##   2 (r_prev - r) over the shrink: shrink_s = max(min_shrink_s, ceil(2 (r_prev - r) / edge_speed_cap_mps));
## - wait_s and damage_per_s are the inputs (whole seconds; damage strictly rising).
## The reach rule, against the drop as the match sees it (data/br.json drop with the map's overrides.br.drop,
## merged by MatchDirector.load_config): the last forced drop lands at T_land = carrier_s + altitude_m /
## max_fall_mps. A soldier landed on the far edge must run D = 2 (play radius - first radius) at run_speed_mps
## before the first shrink ends: T_land + D / run_speed_mps <= wait_1 + shrink_1. And everyone lands before the
## first shrink starts: T_land < wait_1. When either fails, wait_1 is lengthened by whole seconds until both hold,
## and the tool says so (printed line and report).
## Bad inputs are refused: the tool prints the problems, writes nothing and quits with 1.
## Writes overrides.br.zone.phases, start_radius_m (= play_radius_m) and the zone's "_todo" / "_placeholder";
## the rest of the file is kept and written the way tools/gen_alesia.gd writes it (sorted keys, tabs), so the
## same inputs give a byte-identical file.

const DEFAULT_MAP := "res://data/maps/alesia_1km.json"
const ZONE_NOTE := "OQ-BR-ZONE: guesses for Shibi. The phases are GENERATED by tools/gen_zone.gd from this map's top-level \"zone_gen\" block; do not edit them by hand (change zone_gen, re-run the tool, then tools/bake_nav.gd). start_radius_m = play_radius_m (the play circle). radius_m = radius_fraction x the play radius; shrink_s is the shortest whole second that keeps the edge at or below zone_gen.edge_speed_cap_mps (a phase's centre may move by up to (r - target), so its edge moves up to 2 (r - target) over shrink_s), and never below zone_gen.min_shrink_s; wait_s and damage_per_s are zone_gen's, except that the first wait is lengthened when the last drop could not land and reach the first circle in time (the tool reports it)."
## A float from rounding, e.g. 84.0000001, still counts as 84 whole seconds when the shrink is rounded up.
const CEIL_SLACK := 1e-6
const _GenAlesia := preload("res://tools/gen_alesia.gd")


func _initialize() -> void:
	var map_path := DEFAULT_MAP
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--map="):
			map_path = arg.substr(6)
	var map_def := DataRegistry.parse_quiet(map_path)
	if map_def.is_empty():
		printerr("ZONE_GEN problem: map '%s' is missing or not a json dictionary" % map_path)
		quit(1)
		return
	var out := generate(map_def, merged_drop(map_path))
	var problems: PackedStringArray = out["problems"]
	if not problems.is_empty():
		for p in problems:
			printerr("ZONE_GEN problem: ", p)
		quit(1)
		return
	var f := FileAccess.open(map_path, FileAccess.WRITE)
	if f == null:
		printerr("ZONE_GEN problem: cannot write %s: %s" % [map_path, error_string(FileAccess.get_open_error())])
		quit(1)
		return
	f.store_string(text_for(map_def, out["phases"]))
	f.close()
	for line in report_lines(out["report"]):
		print(line)
	quit(0)


## The drop config the match sees on this map: data/br.json "drop" with the map's overrides.br.drop merged in
## (MatchDirector.load_config, the one place the merge happens).
static func merged_drop(map_path: String) -> Dictionary:
	var director := MatchDirector.new()
	director.load_config(map_path)
	var drop: Variant = director.mode_cfg.get("drop", {})
	director.free()
	return (drop as Dictionary).duplicate(true) if typeof(drop) == TYPE_DICTIONARY else {}


static func _is_num(v: Variant) -> bool:
	return typeof(v) == TYPE_INT or typeof(v) == TYPE_FLOAT


static func _is_whole(v: Variant) -> bool:
	return _is_num(v) and float(v) == float(int(v))


## Pure: the phases for map_def's "zone_gen" block and the given drop config. Returns {"phases": Array of
## {damage_per_s, radius_m, shrink_s, wait_s} (all floats, as the json reads back), "report": Dictionary,
## "problems": PackedStringArray}. With problems, phases is empty and report is {}.
static func generate(map_def: Dictionary, drop: Dictionary) -> Dictionary:
	var problems := PackedStringArray()
	var fail := {"phases": [], "report": {}, "problems": problems}
	var zg_v: Variant = map_def.get("zone_gen")
	if typeof(zg_v) != TYPE_DICTIONARY:
		problems.append("the map has no top-level \"zone_gen\" dictionary")
		return fail
	var zg: Dictionary = zg_v
	var play_v: Variant = map_def.get("play_radius_m")
	if not _is_num(play_v) or float(play_v) <= 0.0:
		problems.append("play_radius_m must be a number greater than 0 (got %s)" % str(play_v))
	for key: String in ["run_speed_mps", "edge_speed_cap_mps"]:
		if not _is_num(zg.get(key)) or float(zg[key]) <= 0.0:
			problems.append("zone_gen.%s must be a number greater than 0 (got %s)" % [key, str(zg.get(key))])
	if not _is_whole(zg.get("min_shrink_s")) or float(zg["min_shrink_s"]) <= 0.0:
		problems.append("zone_gen.min_shrink_s must be a whole number of seconds greater than 0 (got %s)" % str(zg.get("min_shrink_s")))
	for key: String in ["carrier_s", "altitude_m"]:
		if not _is_num(drop.get(key)) or float(drop[key]) < 0.0:
			problems.append("drop.%s must be a number of at least 0 (got %s)" % [key, str(drop.get(key))])
	if not _is_num(drop.get("max_fall_mps")) or float(drop["max_fall_mps"]) <= 0.0:
		problems.append("drop.max_fall_mps must be a number greater than 0 (got %s)" % str(drop.get("max_fall_mps")))
	var list_v: Variant = zg.get("phases")
	if typeof(list_v) != TYPE_ARRAY or (list_v as Array).is_empty():
		problems.append("zone_gen.phases must be a non-empty list")
		return fail
	var list: Array = list_v
	var prev_frac := INF
	var prev_damage := -INF
	for i in list.size():
		var w := "zone_gen.phases[%d]" % i
		if typeof(list[i]) != TYPE_DICTIONARY:
			problems.append(w + " is not a dictionary")
			continue
		var p: Dictionary = list[i]
		var frac: Variant = p.get("radius_fraction")
		if not _is_num(frac) or float(frac) < 0.0 or float(frac) >= 1.0:
			problems.append("%s.radius_fraction must be a number in [0, 1) (got %s)" % [w, str(frac)])
		else:
			if float(frac) >= prev_frac:
				problems.append("%s.radius_fraction must be smaller than the one before (%s after %s)" % [w, str(frac), str(prev_frac)])
			prev_frac = float(frac)
		if i == list.size() - 1 and (not _is_num(frac) or float(frac) != 0.0):
			problems.append("%s.radius_fraction: the last phase must be exactly 0 (got %s)" % [w, str(frac)])
		if not _is_whole(p.get("wait_s")) or float(p["wait_s"]) <= 0.0:
			problems.append("%s.wait_s must be a whole number of seconds greater than 0 (got %s)" % [w, str(p.get("wait_s"))])
		var dmg: Variant = p.get("damage_per_s")
		if not _is_num(dmg) or float(dmg) < 0.0:
			problems.append("%s.damage_per_s must be a number of at least 0 (got %s)" % [w, str(dmg)])
		else:
			if float(dmg) <= prev_damage:
				problems.append("%s.damage_per_s must be larger than the one before (%s after %s)" % [w, str(dmg), str(prev_damage)])
			prev_damage = float(dmg)
	if not problems.is_empty():
		return fail
	var r0 := float(play_v)
	var cap := float(zg["edge_speed_cap_mps"])
	var min_shrink := int(zg["min_shrink_s"])
	var phases: Array = []
	var prev := r0
	for i in list.size():
		var p: Dictionary = list[i]
		var r := 0.0 if i == list.size() - 1 else roundf(float(p["radius_fraction"]) * r0 * 10.0) / 10.0
		if r >= prev:
			problems.append("zone_gen.phases[%d]: radius %.1f m (rounded to 0.1 m) is not smaller than the one before (%.1f m)" % [i, r, prev])
			return fail
		var shrink := maxi(min_shrink, ceili(2.0 * (prev - r) / cap - CEIL_SLACK))
		phases.append({"damage_per_s": float(p["damage_per_s"]), "radius_m": r, "shrink_s": float(shrink), "wait_s": float(p["wait_s"])})
		prev = r
	# The reach rule on the first phase: lengthen the first wait by whole seconds until it holds.
	var t_land := float(drop["carrier_s"]) + float(drop["altitude_m"]) / float(drop["max_fall_mps"])
	var reach_m := 2.0 * (r0 - float(phases[0]["radius_m"]))
	var reach_need := t_land + reach_m / float(zg["run_speed_mps"])
	var shrink1 := float(phases[0]["shrink_s"])
	var wait_in := float(phases[0]["wait_s"])
	var wait1 := wait_in
	var reasons := PackedStringArray()
	if wait1 + shrink1 < reach_need:
		reasons.append("reach")
		wait1 = maxf(wait1, float(ceili(reach_need - shrink1)))
		while wait1 + shrink1 < reach_need:
			wait1 += 1.0
	if not t_land < wait1:
		reasons.append("land")
		wait1 = maxf(wait1, float(floori(t_land) + 1))
		while not t_land < wait1:
			wait1 += 1.0
	phases[0]["wait_s"] = wait1
	# The report: per phase edge speed and cumulative end time.
	var rows: Array = []
	var end_s := 0.0
	var max_edge := 0.0
	var waits := PackedInt32Array()
	var shrinks := PackedInt32Array()
	prev = r0
	for ph: Dictionary in phases:
		var edge := 2.0 * (prev - float(ph["radius_m"])) / float(ph["shrink_s"])
		max_edge = maxf(max_edge, edge)
		end_s += float(ph["wait_s"]) + float(ph["shrink_s"])
		waits.append(int(ph["wait_s"]))
		shrinks.append(int(ph["shrink_s"]))
		rows.append({"wait_s": ph["wait_s"], "shrink_s": ph["shrink_s"], "radius_m": ph["radius_m"],
				"damage_per_s": ph["damage_per_s"], "edge_mps": edge, "end_s": end_s})
		prev = float(ph["radius_m"])
	var report := {
		"map": str(map_def.get("id", "")),
		"phases": phases.size(),
		"nominal_s": end_s,
		"waits_s": waits,
		"shrinks_s": shrinks,
		"t_land_s": t_land,
		"reach_m": reach_m,
		"reach_need_s": reach_need,
		"reach_have_s": wait1 + shrink1,
		"wait1_input_s": wait_in,
		"wait1_lengthened_by": int(wait1 - wait_in),
		"wait1_lengthened_for": reasons,
		"max_edge_mps": max_edge,
		"rows": rows,
	}
	return {"phases": phases, "report": report, "problems": problems}


## A copy of map_def with the generated phases in overrides.br.zone (start_radius_m = play_radius_m, the zone
## note refreshed, start_center and every other key kept).
static func apply(map_def: Dictionary, phases: Array) -> Dictionary:
	var out := map_def.duplicate(true)
	if typeof(out.get("overrides")) != TYPE_DICTIONARY:
		out["overrides"] = {}
	if typeof(out["overrides"].get("br")) != TYPE_DICTIONARY:
		out["overrides"]["br"] = {}
	if typeof(out["overrides"]["br"].get("zone")) != TYPE_DICTIONARY:
		out["overrides"]["br"]["zone"] = {}
	var zone: Dictionary = out["overrides"]["br"]["zone"]
	zone["_placeholder"] = true
	zone["_todo"] = ZONE_NOTE
	zone["start_radius_m"] = float(map_def["play_radius_m"])
	zone["phases"] = phases.duplicate(true)
	return out


## The exact text the tool writes for the map json (tools/gen_alesia.gd's writer).
static func text_for(map_def: Dictionary, phases: Array) -> String:
	return _GenAlesia.text_of(apply(map_def, phases))


## The printed lines: one summary line, then one line per phase.
static func report_lines(report: Dictionary) -> PackedStringArray:
	var lines := PackedStringArray()
	var waits := PackedStringArray()
	for v in report["waits_s"]:
		waits.append(str(v))
	var shrinks := PackedStringArray()
	for v in report["shrinks_s"]:
		shrinks.append(str(v))
	var why := ",".join(report["wait1_lengthened_for"]) if not (report["wait1_lengthened_for"] as PackedStringArray).is_empty() else "none"
	lines.append("ZONE_GEN map=%s phases=%d nominal_s=%d waits_s=%s shrinks_s=%s t_land_s=%.1f reach_m=%.1f reach_need_s=%.1f reach_have_s=%d wait1_lengthened_by=%d wait1_lengthened_for=%s max_edge_mps=%.2f" % [
		report["map"], int(report["phases"]), int(report["nominal_s"]), ",".join(waits), ",".join(shrinks), float(report["t_land_s"]),
		float(report["reach_m"]), float(report["reach_need_s"]), int(report["reach_have_s"]), int(report["wait1_lengthened_by"]), why,
		float(report["max_edge_mps"])])
	var rows: Array = report["rows"]
	for i in rows.size():
		var row: Dictionary = rows[i]
		lines.append("ZONE_GEN phase=%d wait_s=%d shrink_s=%d radius_m=%.1f damage_per_s=%s edge_mps=%.2f end_s=%d" % [
			i + 1, int(row["wait_s"]), int(row["shrink_s"]), float(row["radius_m"]), str(row["damage_per_s"]), float(row["edge_mps"]), int(row["end_s"])])
	return lines
