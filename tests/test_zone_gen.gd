extends "res://tests/test_case.gd"
## M2 Z1 stage A: the zone generator (tools/gen_zone.gd). The committed alesia_1km zone phases are exactly the
## tool's output for the map's "zone_gen" inputs and the merged drop (the DRIFT test: hand edits or a changed
## input without a re-run fail here); the tool is deterministic; its rules hold on small made-up inputs (edge cap
## with the round-up, the shortest shrink, the first wait lengthened for a late drop or a long run, with the exact
## whole-second value); bad inputs are refused; "zone_gen" is a top-level key and the map still validates.

const _Tool := preload("res://tools/gen_zone.gd")
const MAP := "res://data/maps/alesia_1km.json"


## The file's text with every "\r" removed (a CRLF checkout compares equal to the tool's LF output).
func _file_text(path: String) -> String:
	return FileAccess.get_file_as_string(path).replace("\r", "")


## A made-up map: play radius 100 m, cap 4 m/s, run 4 m/s, shortest shrink 10 s, the given phases.
func _map(phases: Array, gen_extra: Dictionary = {}, play: Variant = 100.0) -> Dictionary:
	var zg := {"run_speed_mps": 4.0, "edge_speed_cap_mps": 4.0, "min_shrink_s": 10.0, "phases": phases}
	zg.merge(gen_extra, true)
	return {"id": "made_up", "play_radius_m": play, "zone_gen": zg}


func _ph(frac: float, wait: float, dmg: float) -> Dictionary:
	return {"radius_fraction": frac, "wait_s": wait, "damage_per_s": dmg}


## A drop that lands at t_land = carrier_s + 30 / 15 = carrier_s + 2 s.
func _drop(carrier_s: float = 10.0) -> Dictionary:
	return {"carrier_s": carrier_s, "altitude_m": 30.0, "max_fall_mps": 15.0}


func _shrinks(out: Dictionary) -> Array:
	var s: Array = []
	for ph: Dictionary in out["phases"]:
		s.append(float(ph["shrink_s"]))
	return s


func test_committed_phases_are_the_generators_output() -> void:
	var def := DataRegistry.parse_quiet(MAP)
	var drop := _Tool.merged_drop(MAP)
	# The drop is the one the match sees: br.json's with the map's overrides.br.drop on top.
	var br_drop: Dictionary = DataRegistry.new().load_file("res://data/br.json")["drop"]
	assert_eq(float(drop["carrier_s"]), float(def["overrides"]["br"]["drop"]["carrier_s"]), "the map's carrier_s override is in the merged drop")
	# M2 Z1: the map overrides altitude_m and max_fall_mps too; anything it leaves out stays br.json's.
	var map_drop: Dictionary = def["overrides"]["br"]["drop"]
	for key: String in ["altitude_m", "max_fall_mps"]:
		var want := float(map_drop[key]) if map_drop.has(key) else float(br_drop[key])
		assert_eq(float(drop[key]), want, key + " is the map's override, else br.json's")
	var out: Dictionary = _Tool.generate(def, drop)
	assert_true((out["problems"] as PackedStringArray).is_empty(), "the committed inputs are accepted: " + ", ".join(out["problems"]))
	assert_eq(out["phases"], def["overrides"]["br"]["zone"]["phases"], "overrides.br.zone.phases are the generator's output (re-run tools/gen_zone.gd)")
	assert_eq(float(def["overrides"]["br"]["zone"]["start_radius_m"]), float(def["play_radius_m"]), "the zone starts on the play circle")
	assert_eq(float(def["play_radius_m"]), 480.0, "the play radius stays 480 m")
	assert_eq(_Tool.text_for(def, out["phases"]), _file_text(MAP), "the map json is byte for byte what the tool writes")
	var zone: Dictionary = def["overrides"]["br"]["zone"]
	assert_true(bool(zone["_placeholder"]) and String(zone["_todo"]).contains("OQ-BR-ZONE") and String(zone["_todo"]).contains("guess") and String(zone["_todo"]).contains("GENERATED by tools/gen_zone.gd"), "the zone note says it is generated, a guess (OQ-BR-ZONE)")
	var zg: Dictionary = def["zone_gen"]
	assert_true(bool(zg["_placeholder"]) and String(zg["_todo"]).contains("OQ-BR-ZONE") and String(zg["_todo"]).contains("guess"), "zone_gen is a placeholder, labelled a guess (OQ-BR-ZONE)")
	assert_eq(int(out["report"]["wait1_lengthened_by"]), 0, "the committed first wait already meets the reach rule")
	for line in _Tool.report_lines(out["report"]):
		print(line)


func test_deterministic() -> void:
	var def := DataRegistry.parse_quiet(MAP)
	var drop := _Tool.merged_drop(MAP)
	var a: Dictionary = _Tool.generate(def, drop)
	var b: Dictionary = _Tool.generate(def, drop)
	assert_eq(a["phases"], b["phases"], "two runs give the same phases")
	assert_eq(a["report"], b["report"], "two runs give the same report")
	assert_eq(_Tool.text_for(def, a["phases"]), _Tool.text_for(def, b["phases"]), "two runs give the same text")
	# Applying the output to its own result changes nothing (a no-op re-run).
	var applied := _Tool.apply(def, a["phases"])
	assert_eq(_Tool.text_for(applied, _Tool.generate(applied, drop)["phases"]), _Tool.text_for(def, a["phases"]), "a re-run on the written file gives the same file")


func test_edge_cap_rounds_up_to_whole_seconds() -> void:
	# Cap 3 m/s: 2 x 50 / 3 = 33.3 s, so 34 s (33 s would move the edge at 3.03 m/s).
	var out: Dictionary = _Tool.generate(_map([_ph(0.5, 30.0, 1.0), _ph(0.0, 20.0, 2.0)], {"edge_speed_cap_mps": 3.0}), _drop())
	assert_true((out["problems"] as PackedStringArray).is_empty(), "accepted: " + ", ".join(out["problems"]))
	assert_eq(_shrinks(out), [34.0, 34.0], "the shrink is rounded up to the next whole second")
	assert_true(float(out["report"]["max_edge_mps"]) <= 3.0, "the edge stays at or under the cap")
	# Cap 4 m/s: 2 x 50 / 4 = 25 s exactly, not rounded up to 26.
	out = _Tool.generate(_map([_ph(0.5, 30.0, 1.0), _ph(0.0, 20.0, 2.0)]), _drop())
	assert_eq(_shrinks(out), [25.0, 25.0], "an exact whole second is kept")
	assert_eq(float(out["phases"][0]["radius_m"]), 50.0, "radius = fraction x play radius")
	assert_eq(float(out["phases"][1]["radius_m"]), 0.0, "the last radius is exactly 0")
	# Radii are rounded to 0.1 m: 0.333 x 100 = 33.3.
	out = _Tool.generate(_map([_ph(0.333, 30.0, 1.0), _ph(0.0, 20.0, 2.0)]), _drop())
	assert_eq(float(out["phases"][0]["radius_m"]), 33.3, "the radius is rounded to 0.1 m")
	assert_eq(_shrinks(out), [34.0, 17.0], "2 x 66.7 / 4 = 33.35 -> 34 s; 2 x 33.3 / 4 = 16.65 -> 17 s")


func test_min_shrink() -> void:
	# 2 x 10 / 4 = 5 s, raised to min_shrink_s 10; the last 2 x 90 / 4 = 45 s.
	var out: Dictionary = _Tool.generate(_map([_ph(0.9, 30.0, 1.0), _ph(0.0, 20.0, 2.0)]), _drop())
	assert_eq(_shrinks(out), [10.0, 45.0], "no shrink is shorter than min_shrink_s")


func test_first_wait_lengthened_for_a_long_run() -> void:
	# Run 1 m/s: land at 12 s, run 2 x (100 - 50) = 100 m in 100 s, so 112 s; wait 30 + shrink 25 = 55 s.
	# Lengthened to ceil(112 - 25) = 87 s: by 57 s.
	var out: Dictionary = _Tool.generate(_map([_ph(0.5, 30.0, 1.0), _ph(0.0, 20.0, 2.0)], {"run_speed_mps": 1.0}), _drop())
	assert_true((out["problems"] as PackedStringArray).is_empty(), "a long run is fixed, not refused")
	assert_eq(float(out["phases"][0]["wait_s"]), 87.0, "the first wait is lengthened to 87 s")
	assert_eq(int(out["report"]["wait1_lengthened_by"]), 57, "reported: lengthened by 57 s")
	assert_eq(out["report"]["wait1_lengthened_for"], PackedStringArray(["reach"]), "reported: for the reach rule")
	assert_eq(float(out["phases"][1]["wait_s"]), 20.0, "later waits are untouched")
	assert_eq(float(out["report"]["reach_have_s"]), 112.0, "now exactly enough")
	# A fractional need: run 3 m/s, 12 + 100 / 3 = 45.33 s; wait 13 + 25 = 38 s -> ceil(45.33 - 25) = 21 s.
	out = _Tool.generate(_map([_ph(0.5, 13.0, 1.0), _ph(0.0, 20.0, 2.0)], {"run_speed_mps": 3.0}), _drop())
	assert_eq(float(out["phases"][0]["wait_s"]), 21.0, "rounded up to a whole second")
	assert_eq(int(out["report"]["wait1_lengthened_by"]), 8, "lengthened by 8 s")


func test_first_wait_lengthened_for_a_late_drop() -> void:
	# Run 100 m/s (the run is short); the drop lands at 48 s, after the 30 s wait: the wait becomes 49 s.
	var out: Dictionary = _Tool.generate(_map([_ph(0.5, 30.0, 1.0), _ph(0.0, 20.0, 2.0)], {"run_speed_mps": 100.0}), _drop(46.0))
	assert_eq(float(out["report"]["t_land_s"]), 48.0, "lands at 46 + 2 s")
	assert_eq(float(out["phases"][0]["wait_s"]), 49.0, "the first wait ends after the landing (strictly)")
	assert_eq(int(out["report"]["wait1_lengthened_by"]), 19, "lengthened by 19 s")
	assert_eq(out["report"]["wait1_lengthened_for"], PackedStringArray(["land"]), "reported: for the landing rule")
	# A landing at 48.5 s also gives 49 s.
	out = _Tool.generate(_map([_ph(0.5, 30.0, 1.0), _ph(0.0, 20.0, 2.0)], {"run_speed_mps": 100.0}), _drop(46.5))
	assert_eq(float(out["phases"][0]["wait_s"]), 49.0, "a landing at 48.5 s: 49 s")
	# Enough already: nothing changes.
	out = _Tool.generate(_map([_ph(0.5, 30.0, 1.0), _ph(0.0, 20.0, 2.0)]), _drop())
	assert_eq(float(out["phases"][0]["wait_s"]), 30.0, "a wait that is enough stays")
	assert_eq(int(out["report"]["wait1_lengthened_by"]), 0, "reported: not lengthened")


func test_bad_inputs_are_refused() -> void:
	var ok := [_ph(0.5, 30.0, 1.0), _ph(0.0, 20.0, 2.0)]
	var cases := {
		"equal fractions": _map([_ph(0.5, 30.0, 1.0), _ph(0.5, 30.0, 2.0), _ph(0.0, 20.0, 3.0)]),
		"rising fractions": _map([_ph(0.3, 30.0, 1.0), _ph(0.5, 30.0, 2.0), _ph(0.0, 20.0, 3.0)]),
		"last not 0": _map([_ph(0.5, 30.0, 1.0), _ph(0.1, 20.0, 2.0)]),
		"fraction 1": _map([_ph(1.0, 30.0, 1.0), _ph(0.0, 20.0, 2.0)]),
		"negative fraction": _map([_ph(0.5, 30.0, 1.0), _ph(-0.1, 20.0, 2.0)]),
		"equal damage": _map([_ph(0.5, 30.0, 2.0), _ph(0.0, 20.0, 2.0)]),
		"falling damage": _map([_ph(0.5, 30.0, 3.0), _ph(0.0, 20.0, 2.0)]),
		"wait 0": _map([_ph(0.5, 0.0, 1.0), _ph(0.0, 20.0, 2.0)]),
		"wait not whole": _map([_ph(0.5, 30.5, 1.0), _ph(0.0, 20.0, 2.0)]),
		"cap 0": _map(ok, {"edge_speed_cap_mps": 0.0}),
		"run speed negative": _map(ok, {"run_speed_mps": -1.0}),
		"min shrink not whole": _map(ok, {"min_shrink_s": 2.5}),
		"play radius 0": _map(ok, {}, 0.0),
		"no phases": _map([]),
		"rounded radii equal": _map([_ph(0.5004, 30.0, 1.0), _ph(0.5001, 30.0, 2.0), _ph(0.0, 20.0, 3.0)]),
		"no zone_gen": {"id": "made_up", "play_radius_m": 100.0},
	}
	for name: String in cases:
		var out: Dictionary = _Tool.generate(cases[name], _drop())
		assert_true(not (out["problems"] as PackedStringArray).is_empty(), name + ": refused with a problem")
		assert_true((out["phases"] as Array).is_empty(), name + ": no phases")
	var bad_drop: Dictionary = _Tool.generate(_map(ok), {"carrier_s": 10.0, "altitude_m": 30.0, "max_fall_mps": 0.0})
	assert_true(not (bad_drop["problems"] as PackedStringArray).is_empty(), "a drop with max_fall_mps 0 is refused")
	assert_true((_Tool.generate(_map(ok), _drop())["problems"] as PackedStringArray).is_empty(), "the good inputs are accepted")


func test_zone_gen_is_top_level_and_the_map_validates() -> void:
	var def := DataRegistry.parse_quiet(MAP)
	assert_true(def.has("zone_gen") and typeof(def["zone_gen"]) == TYPE_DICTIONARY, "zone_gen is a top-level dictionary of the map json")
	assert_true(not (def["overrides"] as Dictionary).has("zone_gen"), "zone_gen is not inside overrides")
	var reg := DataRegistry.new()
	assert_eq(reg.validate_map(MAP).size(), 0, "alesia_1km validates: " + ", ".join(reg.validate_map(MAP)))
	# Inside overrides it would be refused: overrides may only hold br and loot.
	assert_true(not DataRegistry.overrides_problems({"overrides": {"zone_gen": {}}}).is_empty(), "overrides may not hold zone_gen")
